{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "liliuxflow-edge",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/_liliuxflow/backend/ready",
      "/v1*",
      "/api*",
      "/ui*",
      "/litellm-asset-prefix/_next/static*",
      "/user*",
      "/team*",
      "/key*",
      "/project*",
      "/tag*",
      "/swagger*",
      "/a2a*",
      "/access_group*",
      "/auto_router*",
      "/budget*",
      "/cache/settings*",
      "/claude-code/plugins*",
      "/claude-code/marketplace.json",
      "/cloudzero*",
      "/compliance*",
      "/config*",
      "/coordination_redis/settings*",
      "/credentials*",
      "/global/activity*",
      "/global/spend*",
      "/guardrails*",
      "/model*",
      "/organization*",
      "/policies*",
      "/policy*",
      "/prompts*",
      "/router*",
      "/search_tools*",
      "/spend/logs*",
      "/vector_store*",
      "/v2/*",
      "/schedule/model_cost_map_reload*",
      "/litellm/.well-known/litellm-ui-config",
      "/login",
      "/v3/login",
      "/v3/login/exchange",
      "/health",
      "/health/*",
      "/sso/*",
      "/get/*",
      "/public/*",
      "/gateway/daily/activity",
      "/customer/list",
      "/customer/daily/activity",
      "/openapi.json",
      "/docs/oauth2-redirect",
      "/authorize/flow",
      "/authorize/complete",
      "/agent/daily/activity",
      "/alerting/settings",
      "/callbacks/configs",
      "/cost/estimate",
      "/update/*",
      "/add/allowed_ip",
      "/delete/allowed_ip",
      "/invitation/new",
      "/onboarding/get_token",
      "/onboarding/claim_token",
      "/rag/ingest",
      "/reload/model_cost_map",
      "/usage/ai/chat",
      "/utils/*",
      "/chat/completions",
      "/embeddings",
      "/responses",
      "/audio/speech",
      "/audio/transcriptions",
      "/images/edits",
      "/images/generations"
    ]
  }
}
