@@ -0,0 +1,140 @@
+//! CPU-only prototype: nonblocking message+byte bounded controlled response.
+//! A received envelope keeps its byte reservation until the socket writer
+//! finishes/discards it. Faults cancel only this row; no GPU fence/kernel call.
+use std::sync::{Arc, atomic::{AtomicBool,AtomicU8,AtomicUsize,Ordering},mpsc::{self,SyncSender,Receiver,TrySendError}};
+use std::io::{self,Write};
+
+/// Only used by controlled serialization. Checks before reserving/appending;
+/// legacy serde/to_string stays unchanged. Capacity is also kept <= limit.
+pub struct Frame {bytes:Vec<u8>,limit:usize}
+impl Frame {
+    pub fn new(limit:usize)->Self{Self{bytes:Vec::new(),limit}}
+    pub fn into_bytes(self)->Vec<u8>{self.bytes}
+}
+impl Write for Frame {
+    fn write(&mut self,bytes:&[u8])->io::Result<usize>{
+        let required=self.bytes.len().checked_add(bytes.len()).filter(|n|*n<=self.limit)
+            .ok_or_else(||io::Error::other("controlled_output_frame_oversize"))?;
+        if required>self.bytes.capacity(){
+            let target=required.max(self.bytes.capacity().saturating_mul(2)).max(256).min(self.limit);
+            self.bytes.try_reserve_exact(target-self.bytes.len()).map_err(|_|io::Error::other("controlled_output_frame_allocation"))?;
+        }
+        self.bytes.extend_from_slice(bytes);Ok(bytes.len())
+    }
+    fn flush(&mut self)->io::Result<()>{Ok(())}
+}
+
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+#[repr(u8)]
+pub enum Fault { MessageFull=1, ByteFull=2, OversizedFrame=3, Disconnected=4 }
+impl Fault {fn from(value:u8)->Option<Self>{match value {1=>Some(Self::MessageFull),2=>Some(Self::ByteFull),3=>Some(Self::OversizedFrame),4=>Some(Self::Disconnected),_=>None}}}
+struct State {bytes:AtomicUsize,messages:AtomicUsize,fault:AtomicU8,cancelled:Arc<AtomicBool>,max_messages:usize,max_bytes:usize,max_frame:usize}
+pub struct Envelope<T>{pub value:T,size:usize,state:Arc<State>}
+impl<T> Drop for Envelope<T>{fn drop(&mut self){self.state.bytes.fetch_sub(self.size,Ordering::AcqRel);self.state.messages.fetch_sub(1,Ordering::AcqRel);}}
+// A fault wake carries no body/reservation. If try_send finds a full channel,
+// the waiting reader already has a message available and sees the sticky fault.
+enum Entry<T>{Message(Envelope<T>),FaultWake}
+pub struct Sender<T>{tx:SyncSender<Entry<T>>,state:Arc<State>}
+pub struct Reader<T>{rx:Receiver<Entry<T>>,state:Arc<State>}
+pub enum Read<T>{Message(Envelope<T>),Fault(Fault),Closed}
+
+pub fn bounded<T>(messages:usize,bytes:usize,max_frame:usize,cancelled:Arc<AtomicBool>)->(Sender<T>,Reader<T>){
+    assert!(messages>0&&bytes>0&&max_frame>0&&max_frame<=bytes);
+    let(tx,rx)=mpsc::sync_channel(messages);
+    let state=Arc::new(State{bytes:AtomicUsize::new(0),messages:AtomicUsize::new(0),fault:AtomicU8::new(0),cancelled,max_messages:messages,max_bytes:bytes,max_frame});
+    (Sender{tx,state:state.clone()},Reader{rx,state})
+}
+impl<T> Sender<T>{
+    fn fail(&self,fault:Fault){
+        let first=self.state.fault.compare_exchange(0,fault as u8,Ordering::AcqRel,Ordering::Acquire).is_ok();
+        self.state.cancelled.store(true,Ordering::Release);
+        if first {let _=self.tx.try_send(Entry::FaultWake);}
+    }
+    pub fn abort(&self,fault:Fault){self.fail(fault);}
+    pub fn try_send(&self,value:T,size:usize)->Result<(),Fault>{
+        if let Some(fault)=Fault::from(self.state.fault.load(Ordering::Acquire)){return Err(fault)}
+        if size>self.state.max_frame{self.fail(Fault::OversizedFrame);return Err(Fault::OversizedFrame)}
+        if self.state.messages.fetch_update(Ordering::AcqRel,Ordering::Acquire,|used|
+            used.checked_add(1).filter(|total|*total<=self.state.max_messages)).is_err(){
+            self.fail(Fault::MessageFull);return Err(Fault::MessageFull)
+        }
+        if self.state.bytes.fetch_update(Ordering::AcqRel,Ordering::Acquire,|used|
+            used.checked_add(size).filter(|total|*total<=self.state.max_bytes)).is_err(){
+            self.state.messages.fetch_sub(1,Ordering::AcqRel);
+            self.fail(Fault::ByteFull);return Err(Fault::ByteFull)
+        }
+        let envelope=Envelope{value,size,state:self.state.clone()};
+        match self.tx.try_send(Entry::Message(envelope)){
+            Ok(())=>Ok(()),
+            Err(TrySendError::Full(message))=>{drop(message);self.fail(Fault::MessageFull);Err(Fault::MessageFull)},
+            Err(TrySendError::Disconnected(message))=>{drop(message);self.fail(Fault::Disconnected);Err(Fault::Disconnected)},
+        }
+    }
+    pub fn retained_bytes(&self)->usize{self.state.bytes.load(Ordering::Acquire)}
+    pub fn retained_messages(&self)->usize{self.state.messages.load(Ordering::Acquire)}
+}
+impl<T> Reader<T>{
+    pub fn recv(&self)->Read<T>{
+        if let Some(fault)=Fault::from(self.state.fault.load(Ordering::Acquire)){return Read::Fault(fault)}
+        match self.rx.recv(){
+            Ok(Entry::Message(message))=>{
+                if let Some(fault)=Fault::from(self.state.fault.load(Ordering::Acquire)){drop(message);Read::Fault(fault)}
+                else{Read::Message(message)}
+            },Ok(Entry::FaultWake)|Err(_)=>match Fault::from(self.state.fault.load(Ordering::Acquire)){Some(f)=>Read::Fault(f),None=>Read::Closed}
+        }
+    }
+}
+
+#[cfg(test)]mod tests{
+    use super::*;
+    #[test]fn exactbyte_boundary_and_inflight_writer_counted(){
+        let(tx,rx)=bounded(4,8,8,Arc::new(AtomicBool::new(false)));
+        tx.try_send(vec![0;8],8).unwrap();let held=match rx.recv(){Read::Message(v)=>v,_=>panic!()};
+        assert_eq!(tx.retained_bytes(),8);drop(held);assert_eq!(tx.retained_bytes(),0);
+    }
+    #[test]fn fullbyte_fails_no_wrap_and_cancels_only_owned_row(){
+        let a=Arc::new(AtomicBool::new(false));let b=Arc::new(AtomicBool::new(false));
+        let(tx,_rx)=bounded(4,8,8,a.clone());tx.try_send(1,8).unwrap();
+        assert_eq!(tx.try_send(2,1),Err(Fault::ByteFull));assert!(a.load(Ordering::Acquire));assert!(!b.load(Ordering::Acquire));
+    }
+    #[test]fn message_count_full_is_nonblocking_and_reservation_rolled_back(){
+        let(tx,_rx)=bounded(1,16,8,Arc::new(AtomicBool::new(false)));tx.try_send(1,8).unwrap();
+        assert_eq!(tx.try_send(2,8),Err(Fault::MessageFull));assert_eq!(tx.retained_bytes(),8);
+    }
+    #[test]fn oversized_rejected_before_queue_or_byte_growth(){
+        let(tx,_)=bounded(4,16,8,Arc::new(AtomicBool::new(false)));
+        assert_eq!(tx.try_send(1,9),Err(Fault::OversizedFrame));assert_eq!(tx.retained_bytes(),0);
+    }
+    #[test]fn disconnected_releases_reserved_bytes(){
+        let(tx,rx)=bounded(4,16,8,Arc::new(AtomicBool::new(false)));drop(rx);
+        assert_eq!(tx.try_send(1,8),Err(Fault::Disconnected));assert_eq!(tx.retained_bytes(),0);
+    }
+    #[test]fn fault_is_typed_and_never_normal_end(){
+        let(tx,rx)=bounded(1,16,8,Arc::new(AtomicBool::new(false)));tx.try_send(1,8).unwrap();
+        tx.try_send(2,8).unwrap_err();assert!(matches!(rx.recv(),Read::Fault(Fault::MessageFull)));
+    }
+    #[test]fn two_rows_independent_peer_progress_when_other_backlogged(){
+        let(a,_rx)=bounded(1,16,8,Arc::new(AtomicBool::new(false)));let(b,rx)=bounded(4,16,8,Arc::new(AtomicBool::new(false)));
+        a.try_send(1,8).unwrap();a.try_send(2,8).unwrap_err();
+        b.try_send(3,8).unwrap();assert!(matches!(rx.recv(),Read::Message(_)));assert_eq!(b.retained_bytes(),0);
+    }
+    #[test]fn bounded_frame_rejects_before_vec_growth(){
+        let mut frame=Frame::new(8);frame.write_all(b"12345678").unwrap();
+        assert!(frame.write_all(b"9").is_err());let bytes=frame.into_bytes();assert_eq!(bytes.len(),8);assert!(bytes.capacity()<=8);
+    }
+    #[test]fn retained_message_limit_includes_inflight_writer(){
+        let(tx,rx)=bounded(1,16,8,Arc::new(AtomicBool::new(false)));tx.try_send(1,8).unwrap();
+        let held=match rx.recv(){Read::Message(v)=>v,_=>panic!()};
+        assert_eq!(tx.retained_messages(),1);assert_eq!(tx.try_send(2,8),Err(Fault::MessageFull));
+        assert_eq!(tx.retained_bytes(),8);drop(held);assert_eq!(tx.retained_messages(),0);
+    }
+    #[test]fn empty_waiting_reader_wakes_on_serialization_fault_without_sender_drop(){
+        let(tx,rx)=bounded::<u8>(1,16,8,Arc::new(AtomicBool::new(false)));
+        let(done_tx,done_rx)=mpsc::channel();
+        let handle=std::thread::spawn(move||{done_tx.send(matches!(rx.recv(),Read::Fault(Fault::OversizedFrame))).unwrap();});
+        tx.abort(Fault::OversizedFrame);
+        let result=done_rx.recv_timeout(std::time::Duration::from_secs(2));
+        // Always drop the sender and join, even if the assertion fails.
+        drop(tx);handle.join().unwrap();assert_eq!(result.unwrap(),true);
+    }
+}
