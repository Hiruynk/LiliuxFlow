+        Out::Start { status, content_type } => (*status, *content_type),
+        _ => { cancelled.store(true, Ordering::Relaxed); return; }
+    };
+    drop(first);
+    let mut response = match http::ChunkedResponse::start(watched, status, content_type) {
+        Ok(value) => value, Err(_) => { cancelled.store(true, Ordering::Relaxed); return; }
+    };
+    loop {
+        match rx.recv() {
+            Read::Message(value) => match &value.value {
+                Out::Body(bytes) => { if response.write_chunk(bytes).is_err() { cancelled.store(true, Ordering::Relaxed); return; } }
+                Out::End => break,
+                Out::Start { .. } => { cancelled.store(true, Ordering::Relaxed); return; }
+            },
+            Read::Fault(_) => {
+                // Best-effort typed error within the socket timeout. Never a
+                // normal length/stop terminal; cancellation stays true even if
+                // the peer receives the error and the protocol end marker.
+                if content_type == "text/event-stream" {
+                    let _ = response.write_chunk(controlled_output_error_sse());
+                } else {
+                    let _ = response.write_chunk(&error_json("server_error", "controlled_output_queue_overflow"));
+                }
+                let _ = response.finish(); return;
+            }
+            Read::Closed => return,
+        }
+    }
+    if !cancelled.load(Ordering::Relaxed) { let _ = response.finish(); }
+}
