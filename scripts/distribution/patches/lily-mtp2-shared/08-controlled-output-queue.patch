+fn controlled_output_error_sse() -> &'static [u8] { b"data: {\"error\":{\"type\":\"server_error\",\"code\":\"output_backpressure\",\"message\":\"controlled_output_queue_overflow\"}}\n\ndata: [DONE]\n\n" }
