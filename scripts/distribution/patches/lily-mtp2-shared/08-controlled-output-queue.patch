+fn relay_controlled(stream: TcpStream, http11: bool, rx: output_queue::Reader<Out>, cancelled: Arc<AtomicBool>) {
+    use output_queue::Read;
+    if stream.set_write_timeout(Some(Duration::from_secs(2))).is_err() {
+        cancelled.store(true, Ordering::Relaxed); return;
+    }
+    let watched = http::Watched::new(stream, http11, cancelled.clone());
+    let first = match rx.recv() {
+        Read::Message(value) => value,
+        Read::Fault(_) => {
+            let _ = watched.respond(503, "application/json", &error_json("server_error", "controlled_output_queue_overflow"));
+            return;
+        }
+        Read::Closed => return,
+    };
