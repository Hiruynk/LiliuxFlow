+/// Counts the real model loader's calls across idle unload and fault recovery.
+/// A successful load fingerprints its recorded weight buffers before scratch exists.
+pub(super) struct WeightLoads {
+    salt: [u8; 32],
+    started: AtomicU64,
+    completed: AtomicU64,
+    recorded_generation: AtomicU64,
+}
+
+#[derive(Debug, Clone)]
+pub(super) struct WeightResidency {
+    pub generation: u64,
+    pub load_count: u64,
+    pub allocation_id: String,
+    pub buffer_count: usize,
+    pub allocation_bytes: u64,
+    pub paged_weight_bytes: u64,
+}
+
+// `fetch_update` is kept for the crate's Rust 1.92 MSRV.
+#[allow(deprecated)]
+impl WeightLoads {
+    pub(super) fn new() -> Result<Self> {
+        let mut salt = [0; 32];
+        std::fs::File::open("/dev/urandom")?.read_exact(&mut salt)?;
+        Ok(Self {
+            salt,
+            started: AtomicU64::new(0),
+            completed: AtomicU64::new(0),
+            recorded_generation: AtomicU64::new(0),
+        })
+    }
+
+    pub(super) fn begin(&self) -> Result<u64> {
+        let previous = self
+            .started
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| n.checked_add(1))
+            .map_err(|_| anyhow::anyhow!("weight load counter exhausted"))?;
+        Ok(previous + 1)
+    }
+
+    /// Handles are hashed with a private random salt; no address is retained or
+    /// formatted. The generation also distinguishes reuse of an allocation address.
+    pub(super) fn loaded(
+        &self,
+        generation: u64,
+        buffers: impl IntoIterator<Item = (usize, usize)>,
+        paged_weight_bytes: u64,
+    ) -> Result<WeightResidency> {
+        ensure!(
+            generation > 0 && generation <= self.started.load(Ordering::Relaxed),
+            "weight allocation has no actual load generation"
+        );
+        let mut seen = HashSet::new();
+        let mut bytes = 0u64;
+        let mut digest = Sha256::new();
+        digest.update(b"liliuxflow-mtp2-weight-allocation-v1");
+        digest.update(&self.salt);
+        digest.update(&generation.to_le_bytes());
+        for (handle, size) in buffers {
+            if seen.insert(handle) {
+                bytes = bytes
+                    .checked_add(size as u64)
+                    .context("weight allocation bytes overflow")?;
+                digest.update(&handle.to_le_bytes());
+                digest.update(&size.to_le_bytes());
+            }
+        }
+        ensure!(
+            !seen.is_empty() && bytes > 0,
+            "shared MTP2 has no recorded weight allocations"
+        );
+        self.recorded_generation
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |previous| {
+                (generation > previous).then_some(generation)
+            })
+            .map_err(|_| {
+                anyhow::anyhow!("weight load generation was already recorded")
+            })?;
+        let allocation_id =
+            digest.finish().iter().map(|b| format!("{b:02x}")).collect();
+        let load_count = self
+            .completed
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| n.checked_add(1))
+            .map_err(|_| anyhow::anyhow!("weight load counter exhausted"))?
+            + 1;
+        Ok(WeightResidency {
+            generation,
+            load_count,
+            allocation_id,
+            buffer_count: seen.len(),
+            allocation_bytes: bytes,
+            paged_weight_bytes,
+        })
+    }
+}
