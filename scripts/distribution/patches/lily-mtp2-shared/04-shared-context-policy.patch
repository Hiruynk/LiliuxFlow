+#[test]
+fn smaller_logical_contexts_and_real_terminal_reasons_do_not_enter_the_physical_tail() {
+    for profile in [Profile::Ctx64k, Profile::Ctx128k] {
+        let mut boundary = ContextTail::new(profile.context_tokens() - 2, 2).unwrap();
+        assert!(boundary.observe(true).unwrap());
+        assert!(boundary.observe(true).unwrap());
+        assert!(!boundary.should_resume(FinishReason::Length));
+    }
+    let mut boundary = ContextTail::new(RESIDENT_CONTEXT_TOKENS - 10, 10).unwrap();
+    assert!(!boundary.observe(true).unwrap());
+    assert!(boundary.should_resume(FinishReason::Callback));
+    assert!(
+        !boundary.observe(false).unwrap(),
+        "a later real cancel/stop wins over a yield"
+    );
+    assert!(!boundary.should_resume(FinishReason::Callback));
+    assert!(
+        !boundary.observe(true).unwrap(),
+        "a terminal cannot be revived by another callback"
+    );
+    assert!(ContextTail::new(RESIDENT_CONTEXT_TOKENS, 1).is_err());
+    assert!(ContextTail::new(RESIDENT_CONTEXT_TOKENS - 1, 2).is_err());
+    let mut resumed =
+        ContextTail::resuming(RESIDENT_CONTEXT_TOKENS - 13, 13, 2).unwrap();
+    assert!(!resumed.observe(true).unwrap());
+    assert!(resumed.should_resume(FinishReason::Callback));
+}
