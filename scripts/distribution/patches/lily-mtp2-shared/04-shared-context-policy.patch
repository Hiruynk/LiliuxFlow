+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+enum BoundaryStop {
+    #[default]
+    None,
+    TailYield,
+    Terminal,
+}
+
+/// Distinguishes an internal boundary yield from a real callback stop. Thinking
+/// insertions may call back again after a yield, so a later terminal always wins.
+#[derive(Debug)]
+pub(super) struct ContextTail {
+    prompt_tokens: usize,
+    output_tokens: usize,
+    emitted: usize,
+    stop: BoundaryStop,
+}
+
+impl ContextTail {
+    pub(super) fn new(prompt_tokens: usize, output_tokens: usize) -> Result<Self> {
+        Self::resuming(prompt_tokens, output_tokens, 0)
+    }
+
+    /// A future row resume starts with its already-delivered draw count. It must
+    /// use the same boundary policy; it cannot reset its output or seed index.
+    pub(super) fn resuming(
+        prompt_tokens: usize,
+        output_tokens: usize,
+        emitted: usize,
+    ) -> Result<Self> {
+        ensure!(
+            prompt_tokens > 0
+                && output_tokens > 0
+                && output_tokens <= OUTPUT_TOKENS
+                && emitted <= output_tokens
+                && output_tokens
+                    <= RESIDENT_CONTEXT_TOKENS.saturating_sub(prompt_tokens),
+            "invalid shared MTP2 physical token budget"
+        );
+        Ok(Self { prompt_tokens, output_tokens, emitted, stop: BoundaryStop::None })
+    }
+
+    pub(super) fn observe(&mut self, keep: bool) -> Result<bool> {
+        self.emitted += 1;
+        ensure!(
+            self.emitted <= self.output_tokens,
+            "MTP2 emitted beyond the output budget"
+        );
+        if !keep {
+            self.stop = BoundaryStop::Terminal;
+            return Ok(false);
+        }
+        let rest = self.prompt_tokens + self.emitted - 1;
+        if self.emitted < self.output_tokens
+            && RESIDENT_CONTEXT_TOKENS - rest < PHYSICAL_TAIL_RESERVE
+            && self.stop != BoundaryStop::Terminal
+        {
+            self.stop = BoundaryStop::TailYield;
+            return Ok(false);
+        }
+        Ok(self.stop == BoundaryStop::None)
+    }
+
+    pub(super) fn should_resume(&self, finish: FinishReason) -> bool {
+        self.stop == BoundaryStop::TailYield
+            && finish == FinishReason::Callback
+            && self.emitted < self.output_tokens
+    }
+
+    /// An insertion can finish its group after the internal yield callback.
+    /// Reaching the real budget is Length; a true stop or cancellation wins.
+    pub(super) fn finish_reason(
+        &self,
+        finish: FinishReason,
+        active: bool,
+    ) -> FinishReason {
+        if active
+            && self.stop == BoundaryStop::TailYield
+            && finish == FinishReason::Callback
+            && self.emitted == self.output_tokens
+        {
+            FinishReason::Length
+        } else {
+            finish
+        }
+    }
+}
+
+pub(super) struct TailEvidence {
+    pub tokens: usize,
+    pub start_position: usize,
+    pub end_position: usize,
+    pub generated_tokens: usize,
+}
+
+impl TailEvidence {
+    pub(super) fn line(&self, request_id: &str) -> String {
+        format!(
+            "[lily-meta] request_id={request_id} phase=mtp2_context_tail reason=physical_context_scratch_reserve reserve_tokens={PHYSICAL_TAIL_RESERVE} context_tail_tokens={} start_position={} end_position={} generated_tokens={} resident_context_tokens={RESIDENT_CONTEXT_TOKENS} mtp_drafts={DRAFTS}",
+            self.tokens, self.start_position, self.end_position, self.generated_tokens
+        )
+    }
+}
+
+/// The original speculative loop settles with finish_speculation(None) before
+/// returning Callback. Resume only its bounded physical tail on the same state,
+/// parser, sampler indices and checkpoints. The normal loop and engine stay MTP2.
+#[allow(clippy::too_many_arguments)]
+pub(super) fn generate_bounded<M: LanguageModel>(
+    generator: &Generator,
+    ctx: &MetalContext,
+    model: &M,
+    state: &mut M::State,
+    scratch: &mut M::Scratch,
+    prompt: &[u32],
+    prompt_tokens: usize,
+    options: &GenerateOptions<'_>,
+    mut checkpoints: Option<&mut dyn DecodeCheckpointer<M::State>>,
+    on_token: &mut dyn FnMut(u32) -> Result<bool>,
+    is_active: &dyn Fn() -> bool,
+) -> Result<(Generation, Option<TailEvidence>)> {
+    ensure!(
+        options.drafts == DRAFTS && model.max_drafts() >= DRAFTS,
+        "shared MTP2 requires two available drafts"
+    );
+    ensure!(
+        state.pos().checked_add(prompt.len()) == Some(prompt_tokens),
+        "shared MTP2 prompt/state position mismatch"
+    );
+    let before = state.pos();
+    let mut boundary = ContextTail::new(prompt_tokens, options.max_tokens)?;
+    let mut generation = generator.generate_checkpointed(
+        ctx,
+        model,
+        state,
+        scratch,
+        prompt,
+        options,
+        checkpoints.as_mut().map(|c| &mut **c as &mut dyn DecodeCheckpointer<M::State>),
+        &mut |token| boundary.observe(on_token(token)?),
+    )?;
+    let active = is_active();
+    generation.finish = boundary.finish_reason(generation.finish, active);
+    if !boundary.should_resume(generation.finish) || !active {
+        return Ok((generation, None));
+    }
+    ensure!(
+        state.pos() == prompt_tokens + generation.tokens.len() - 1,
+        "MTP2 tail did not settle with its last draw unfed"
+    );
+    let remaining = options.max_tokens - generation.tokens.len();
+    let start_position = state.pos();
+    ensure!(
+        RESIDENT_CONTEXT_TOKENS - state.pos() < PHYSICAL_TAIL_RESERVE
+            && remaining < PHYSICAL_TAIL_RESERVE,
+        "MTP2 ordinary tail escaped the physical boundary"
+    );
+    let tail_options = GenerateOptions {
+        max_tokens: options.max_tokens,
+        sampling: options.sampling,
+        stop_tokens: options.stop_tokens,
+        drafts: 0,
+        thinking: options.thinking,
+    };
+    let drawn = generation.tokens.len();
+    let resumed = generator.resume(
+        ctx,
+        model,
+        state,
+        scratch,
+        &mut generation.tokens,
+        &tail_options,
+        checkpoints,
+        on_token,
+    )?;
+    let tail_tokens = generation.tokens.len() - drawn;
+    let rest = prompt_tokens + generation.tokens.len() - 1;
+    ensure!(
+        state.pos() == rest + usize::from(resumed.parked_draw.is_some()),
+        "MTP2 tail state/draw position mismatch"
+    );
+    generation.finish = resumed.finish;
+    generation.drafted += resumed.drafted;
+    generation.accepted += resumed.accepted;
+    generation.fed =
+        state.pos().checked_sub(before).context("MTP2 tail moved backwards")?;
+    let evidence = TailEvidence {
+        tokens: tail_tokens,
+        start_position,
+        end_position: state.pos(),
+        generated_tokens: generation.tokens.len(),
+    };
+    Ok((generation, Some(evidence)))
+}
