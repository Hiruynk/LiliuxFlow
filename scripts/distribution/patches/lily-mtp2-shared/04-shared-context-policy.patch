+#[test]
+fn physical_tail_has_the_exact_pinned_two_draft_scratch_reserve() {
+    assert_eq!(DRAFTS, 2);
+    assert_eq!(PHYSICAL_TAIL_RESERVE, 12);
+    for room in [1, 2, 10, 11, 12, 13, 14, 20] {
+        let prompt = RESIDENT_CONTEXT_TOKENS - room;
+        let mut boundary = ContextTail::new(prompt, room).unwrap();
+        for emitted in 1..=room {
+            let keep = boundary.observe(true).unwrap();
+            let rest = prompt + emitted - 1;
+            if !keep {
+                assert!(RESIDENT_CONTEXT_TOKENS - rest < PHYSICAL_TAIL_RESERVE);
+                assert!(room - emitted < PHYSICAL_TAIL_RESERVE);
+                assert!(boundary.should_resume(FinishReason::Callback));
+                assert!(!boundary.should_resume(FinishReason::Length));
+                assert!(!boundary.should_resume(FinishReason::StopToken));
+                break;
+            }
+            if emitted == room {
+                assert!(!boundary.should_resume(FinishReason::Length));
+            }
+        }
+    }
+    let mut last = ContextTail::new(RESIDENT_CONTEXT_TOKENS - 1, 1).unwrap();
+    assert!(last.observe(true).unwrap(), "the last draw reaches length directly");
+    assert!(!last.should_resume(FinishReason::Length));
+    assert!(last.observe(true).is_err(), "no extra output token is admitted");
+}
