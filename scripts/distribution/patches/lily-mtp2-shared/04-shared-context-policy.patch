+//! Opt-in shared MTP2 context policies. This module does not schedule peers.
+//! A profile limits one request; the engine's context and draft count stay fixed.
+
+use std::collections::HashSet;
+use std::io::Read;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use anyhow::{Context as _, Result, ensure};
+use serde::Deserialize;
+use serde::de::{Deserializer, Visitor};
+use serde_json::Value;
+
+use crate::engine::{DecodeStateApi, LanguageModel};
+use crate::generate::{
+    DecodeCheckpointer, FinishReason, GenerateOptions, Generation, Generator,
+};
+use crate::metal::MetalContext;
+use crate::sha256::Sha256;
+
+pub const RESIDENT_CONTEXT_TOKENS: usize = 262_144;
+pub const OUTPUT_TOKENS: usize = 65_536;
+pub const DRAFTS: usize = 2;
+// Pinned verify: m=(1+k), ahead_rows=2*(1+chain), ensure_room adds MAX_DRAFTS.
+// The candidate fixes k=chain=2; changing that contract needs a new audit.
+pub const PHYSICAL_TAIL_RESERVE: usize =
+    (1 + DRAFTS) + 2 * (1 + DRAFTS) + crate::qwen4exp::MAX_DRAFTS;
+
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub enum PolicyMode {
+    #[default]
+    Disabled,
+    SharedMtp2,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Profile {
+    Ctx64k,
+    Ctx128k,
+    Ctx262k,
+}
+
+impl Profile {
+    pub const ALL: [Self; 3] = [Self::Ctx64k, Self::Ctx128k, Self::Ctx262k];
+
+    pub fn id(self) -> &'static str {
+        match self {
+            Self::Ctx64k => "ctx64k-mtp2",
+            Self::Ctx128k => "ctx128k-mtp2",
+            Self::Ctx262k => "ctx262k-mtp2",
+        }
+    }
+
+    pub fn alias(self) -> &'static str {
+        match self {
+            Self::Ctx64k => "qwen3.8-flash-next-lily-q4-mtp2-64k",
+            Self::Ctx128k => "qwen3.8-flash-next-lily-q4-mtp2-128k",
+            Self::Ctx262k => "qwen3.8-flash-next-lily-q4-mtp2-262k",
+        }
+    }
+
+    pub fn context_tokens(self) -> usize {
+        match self {
+            Self::Ctx64k => 65_536,
+            Self::Ctx128k => 131_072,
+            Self::Ctx262k => RESIDENT_CONTEXT_TOKENS,
+        }
+    }
+}
+
+impl<'de> Deserialize<'de> for Profile {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct ProfileVisitor;
+        impl Visitor<'_> for ProfileVisitor {
+            type Value = Profile;
+            fn expecting(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                f.write_str("a supported liliuxflow_profile string")
+            }
+            fn visit_str<E: serde::de::Error>(self, value: &str) -> Result<Profile, E> {
+                match value {
+                    "ctx64k-mtp2" => Ok(Profile::Ctx64k),
+                    "ctx128k-mtp2" => Ok(Profile::Ctx128k),
+                    "ctx262k-mtp2" => Ok(Profile::Ctx262k),
+                    _ => Err(E::custom("unsupported liliuxflow_profile")),
+                }
+            }
+        }
+        deserializer.deserialize_str(ProfileVisitor)
+    }
+}
+
+/// Missing is allowed by serde's field default; an explicit null is not a policy.
+pub fn deserialize_profile<'de, D: Deserializer<'de>>(
+    deserializer: D,
+) -> Result<Option<Profile>, D::Error> {
+    Profile::deserialize(deserializer).map(Some)
+}
+
+/// Only the finite profile is stored. The ceiling cannot drift from its mapping.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct RequestPolicy {
+    profile: Profile,
+}
+
+impl RequestPolicy {
+    pub fn profile(self) -> Profile {
+        self.profile
+    }
+    pub fn context_tokens(self) -> usize {
+        self.profile.context_tokens()
+    }
+    pub fn alias(self) -> &'static str {
+        self.profile.alias()
+    }
+
+    pub(super) fn validate_tokens(
+        self,
+        prompt_tokens: usize,
+        output_tokens: usize,
+        resident_context: usize,
+    ) -> Result<()> {
+        ensure!(
+            self.context_tokens() <= resident_context,
+            "request context exceeds resident context"
+        );
+        ensure!(
+            prompt_tokens > 0 && prompt_tokens < self.context_tokens(),
+            "prompt exceeds the request context: {prompt_tokens} prompt tokens, {} tokens of context (at least one completion token must fit)",
+            self.context_tokens()
+        );
+        ensure!(
+            output_tokens > 0 && output_tokens <= OUTPUT_TOKENS,
+            "output exceeds the shared MTP2 output budget"
+        );
+        ensure!(
+            output_tokens <= self.context_tokens() - prompt_tokens,
+            "prompt plus output exceeds the request context"
+        );
+        Ok(())
+    }
+}
+
+pub(super) fn resolve_policy(
+    mode: PolicyMode,
+    profile: Option<Profile>,
+    resident_context: usize,
+    kwargs: Option<&Value>,
+) -> Result<Option<RequestPolicy>> {
+    match mode {
+        PolicyMode::Disabled => {
+            ensure!(
+                profile.is_none(),
+                "liliuxflow_profile requires the shared MTP2 candidate"
+            );
+            Ok(None)
+        }
+        PolicyMode::SharedMtp2 => {
+            ensure!(
+                resident_context == RESIDENT_CONTEXT_TOKENS,
+                "shared MTP2 requires its fixed resident context"
+            );
+            ensure!(
+                !kwargs.and_then(Value::as_object).is_some_and(|object| object
+                    .keys()
+                    .any(|key| key.starts_with("liliuxflow_"))),
+                "reserved shared MTP2 policy fields are not allowed in chat_template_kwargs"
+            );
+            let profile = profile.context(
+                "liliuxflow_profile is required by the shared MTP2 candidate",
+            )?;
+            Ok(Some(RequestPolicy { profile }))
+        }
+    }
+}
