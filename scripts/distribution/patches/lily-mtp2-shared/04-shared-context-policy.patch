+#[test]
+fn an_inserted_group_that_fills_the_budget_ends_with_length_unless_a_real_terminal_wins()
+ {
+    let mut group = ContextTail::new(RESIDENT_CONTEXT_TOKENS - 2, 2).unwrap();
+    assert!(!group.observe(true).unwrap());
+    assert!(!group.observe(true).unwrap());
+    assert!(!group.should_resume(FinishReason::Callback));
+    assert_eq!(group.finish_reason(FinishReason::Callback, true), FinishReason::Length);
+    assert_eq!(
+        group.finish_reason(FinishReason::Callback, false),
+        FinishReason::Callback
+    );
+    assert_eq!(
+        group.finish_reason(FinishReason::StopToken, true),
+        FinishReason::StopToken
+    );
+    let mut cancelled = ContextTail::new(RESIDENT_CONTEXT_TOKENS - 2, 2).unwrap();
+    assert!(!cancelled.observe(true).unwrap());
+    assert!(!cancelled.observe(false).unwrap());
+    assert_eq!(
+        cancelled.finish_reason(FinishReason::Callback, true),
+        FinishReason::Callback
+    );
