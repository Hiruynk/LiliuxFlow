+fn fake_loads() -> WeightLoads {
+    WeightLoads {
+        salt: [37; 32],
+        started: AtomicU64::new(0),
+        completed: AtomicU64::new(0),
+        recorded_generation: AtomicU64::new(0),
+    }
+}
+
+#[test]
+fn weight_identity_is_bound_to_real_load_generation_and_recorded_allocations() {
+    let loads = fake_loads();
+    let first_generation = loads.begin().unwrap();
+    // Synthetic handles only. Repeated references do not double-count a buffer.
+    let first =
+        loads.loaded(first_generation, [(10, 40), (11, 60), (10, 40)], 100).unwrap();
+    assert_eq!((first.generation, first.load_count), (1, 1));
+    assert_eq!(
+        (first.buffer_count, first.allocation_bytes, first.paged_weight_bytes),
+        (2, 100, 100)
+    );
+    assert!(loads.loaded(first_generation, [(10, 40), (11, 60)], 100).is_err());
+    assert_eq!(
+        loads.completed.load(Ordering::Relaxed),
+        1,
+        "the same load cannot be counted twice"
+    );
+    assert_eq!(first.allocation_id.len(), 64);
+    assert!(
+        first
+            .allocation_id
+            .bytes()
+            .all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase())
+    );
+    let stable = first.clone();
+    for profile in Profile::ALL {
+        let policy = resolve_policy(
+            PolicyMode::SharedMtp2,
+            Some(profile),
+            RESIDENT_CONTEXT_TOKENS,
+            None,
+        )
+        .unwrap()
+        .unwrap();
+        let line = stable.policy_line("req-synthetic-1", policy, 10, 20);
+        assert!(line.contains(&format!("profile_id={}", profile.id())));
+        assert!(
+            line.contains(&format!("weight_allocation_id={}", first.allocation_id))
+        );
+        assert!(line.contains("weight_load_count=1"));
+    }
+    let reloaded =
+        loads.loaded(loads.begin().unwrap(), [(10, 40), (11, 60)], 100).unwrap();
+    assert_eq!((reloaded.generation, reloaded.load_count), (2, 2));
+    assert_ne!(
+        reloaded.allocation_id, first.allocation_id,
+        "address reuse is still a new real load"
+    );
+    let another =
+        loads.loaded(loads.begin().unwrap(), [(12, 40), (13, 60)], 100).unwrap();
+    assert_ne!(another.allocation_id, reloaded.allocation_id);
+    assert!(another.resident_line().contains(
+        "weight_buffer_count=2 weight_allocation_bytes=100 paged_weight_bytes=100"
+    ));
+    let other_loads = fake_loads();
+    let other = other_loads
+        .loaded(other_loads.begin().unwrap(), [(12, 40), (13, 60)], 100)
+        .unwrap();
+    assert_ne!(
+        other.allocation_id, first.allocation_id,
+        "actual allocation handles affect the identity with identical salt/generation"
+    );
+}
