+fn check_shared_mtp2_options(options: &ServeOptions) -> Result<()> {
+    if !options.liliuxflow_mtp2_shared_context { return Ok(()); }
+    ensure!(options.max_seq == mtp2::RESIDENT_CONTEXT_TOKENS,
+        "shared MTP2 requires --max-seq 262144");
+    ensure!(options.mtp_drafts == mtp2::DRAFTS,
+        "shared MTP2 requires --mtp-drafts 2");
+    ensure!(options.kv_format == Some(KvFormat::Bf16),
+        "shared MTP2 requires explicit --kv-cache bf16");
+    ensure!(options.max_batch == Some(1),
+        "shared MTP2 P1 requires --max-batch 1; peer scheduling is unavailable");
+    ensure!(options.pin_weights == pin::PinMode::Off && options.ngram_preload
+        && !options.ngram_lock, "shared MTP2 requires pin off and unlocked n-gram preload");
+    ensure!(options.thinking
+        && options.reasoning_effort.as_deref().is_none_or(|e| matches!(e, "high" | "xhigh" | "max"))
+        && options.thinking_controls.budgets == api::ThinkingBudgets::default()
+        && !options.thinking_controls.nudges && !options.thinking_controls.tool_call_ends_thinking,
+        "shared MTP2 requires checkpoint high thinking with default thinking controls off");
+    ensure!(options.disk_cache_bytes == 0,
+        "shared MTP2 P1 requires the existing disabled disk cache");
+    Ok(())
+}
+
+fn check_shared_mtp2_route(route: Option<&str>, scores: Option<&str>) -> Result<()> {
