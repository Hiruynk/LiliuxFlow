+/// Runs only after the complete prompt was tokenized and image pads expanded.
+fn resolve_request_budget(
+    prompt_tokens: usize,
+    requested: Option<usize>,
+    resident_context: usize,
+    policy: Option<RequestPolicy>,
+) -> Result<Budget> {
+    let Some(policy) = policy else {
+        return resolve_budget(prompt_tokens, requested, resident_context);
+    };
+    let asked = requested.unwrap_or(mtp2::OUTPUT_TOKENS);
+    let mut budget = resolve_budget(prompt_tokens, Some(asked.min(mtp2::OUTPUT_TOKENS)),
+        policy.context_tokens())?;
+    budget.clamped_from = requested.filter(|&n| n > budget.max_tokens);
+    policy.validate_tokens(prompt_tokens, budget.max_tokens, resident_context)?;
+    Ok(budget)
+}
