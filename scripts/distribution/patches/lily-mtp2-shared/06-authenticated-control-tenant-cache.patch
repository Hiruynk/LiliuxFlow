+/// Fixed native-control reply only. Extra values are MAC/epoch/challenge
+/// generated by the authenticated control module, not caller header text.
+pub(super) fn respond_control(mut stream: TcpStream, reply: super::mtp2_control::SignedReply) -> Result<()> {
+    let length=reply.body.len().to_string();
+    let mut extra=vec![("Content-Length",length.as_str())];
+    for (name,value) in &reply.headers {
+        if *name!="Content-Type" {extra.push((*name,value.as_str()));}
+    }
+    stream.write_all(head(reply.status,"application/json",&extra).as_bytes()).context("writing control head")?;
+    stream.write_all(&reply.body).context("writing control body")?;
+    stream.flush().ok();stream.shutdown(Shutdown::Both).ok();Ok(())
 }
 
