+#[test]
+fn mtp2_control_key_fd_requires_owned_private_readonly_exact_hex_and_accepts_unlinked_fd() {
+    use std::os::fd::IntoRawFd;
+    use std::os::unix::fs::PermissionsExt;
+    static NEXT:AtomicU64=AtomicU64::new(0);
+    let root=std::env::temp_dir().join(format!("lily-control-fd-cpu-{}-{}",std::process::id(),NEXT.fetch_add(1,Ordering::Relaxed)));
+    std::fs::create_dir(&root).unwrap();
+    std::fs::set_permissions(&root,std::fs::Permissions::from_mode(0o700)).unwrap();
+    for (i,bytes,mode,writable,valid) in [
+        (0,"1".repeat(64).into_bytes(),0o600,false,true),
+        (1,"1".repeat(63).into_bytes(),0o600,false,false),
+        (2,"1".repeat(65).into_bytes(),0o600,false,false),
+        (3,"1".repeat(64).into_bytes(),0o644,false,false),
+        (4,"1".repeat(64).into_bytes(),0o600,true,false),
+        (5,"A".repeat(64).into_bytes(),0o600,false,false),
+        (6,vec![0xff;64],0o600,false,false),
+    ] {
+        let path=root.join(i.to_string());std::fs::write(&path,&bytes).unwrap();
+        std::fs::set_permissions(&path,std::fs::Permissions::from_mode(mode)).unwrap();
+        let file=std::fs::OpenOptions::new().read(true).write(writable).open(&path).unwrap();
+        std::fs::remove_file(&path).unwrap(); // Runner passes an already-unlinked file.
+        let fd=file.into_raw_fd();let result=read_control_key(fd);
+        assert_eq!(result.is_ok(),valid);
+        assert_eq!(unsafe{libc::fcntl(fd,libc::F_GETFD)},-1,"native consumes and closes its inherited descriptor");
+        if let Err(error)=result {assert!(!error.to_string().contains('A'));}
+    }
+    let directory=std::fs::File::open(&root).unwrap().into_raw_fd();
+    assert!(read_control_key(directory).is_err());
+    assert!(read_control_key(-1).is_err());assert!(read_control_key(0).is_err());
+    std::fs::remove_dir(&root).unwrap();
+}
