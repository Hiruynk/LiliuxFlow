+/// Sole HTTP/CPU owner. Its drop marks pending disposal facts, not a release.
+/// The engine pumps these at settled boundaries with its private authority.
+struct CpuAdmissionGuard {
+    control: Arc<mtp2_control::Control>, token: mtp2_control::RequestToken,
+    queue: Arc<EngineQueue>, jobs: SyncSender<Cmd>, cancelled: Arc<AtomicBool>,
+    expected_profile: &'static str, reserved: bool, ever_reserved: bool, acquired: bool,
+    scope:Option<mtp2_control::TenantScope>, session_started:bool, session_disposed:bool,
+}
+impl CpuAdmissionGuard {
+    fn publish(&mut self) -> Result<()> {
+        self.control.before_publish(&self.token,||self.queue.admit())?;
+        self.reserved=true;self.ever_reserved=true;Ok(())
+    }
+    fn dequeued(&mut self, owner:&EngineControlOwner) -> Result<()> {
+        ensure!(self.reserved,"mtp2_control_queue_ownership");
+        self.queue.left();self.reserved=false;
+        let mut authority=owner.try_borrow_mut().map_err(|_|anyhow::anyhow!("mtp2_control_owner_borrow"))?;
+        self.control.queue_returned(&mut authority,&self.token)?;Ok(())
+    }
+}
+impl Drop for CpuAdmissionGuard {
+    fn drop(&mut self) {
+        if self.acquired {return;} // Only explicit engine cleanup may release.
+        if self.reserved {self.queue.left();self.reserved=false;}
+        let fact=if self.ever_reserved {mtp2_control::CpuDisposal::ReservationReturned}
+            else {mtp2_control::CpuDisposal::NeverReserved};
+        if self.control.note_cpu_disposed(&self.token,fact).is_ok() {
+            // Ledger mutex has returned. This is nonblocking and never wakes GPU.
+            // A full inbox already wakes its receiver; pending bit also yields solo.
+            let _=self.jobs.try_send(Cmd::Wake);
+        }
+    }
+}
+fn dequeue_job(job:&mut Job, queue:&EngineQueue, owner:Option<&EngineControlOwner>) -> Result<()> {
+    if let Some(guard)=job.sink.control_admission.as_mut() {
+        guard.dequeued(owner.context("mtp2_control_owner_missing")?)
+    } else {queue.left();Ok(())}
 }
 
