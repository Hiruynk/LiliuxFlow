+// SPDX-License-Identifier: Apache-2.0
+//! Staged, unwired MTP2-only native control v1. No socket, model, GPU or env I/O.
+//! `Control` may be shared with HTTP threads. The separately returned authority
+//! moves to the sole engine thread; it is not Clone/Sync or obtainable from Control.
+//! Callers must retain exact process/port/lease ownership checks. This module does
+//! not prove those facts or infer cleanup from response completion.
+
+use std::cell::Cell;
+use std::collections::{HashMap, HashSet, VecDeque};
+use std::ffi::c_void;
+use std::sync::{Arc, Mutex, MutexGuard};
+use std::sync::atomic::{AtomicBool, Ordering, compiler_fence};
+use serde::Deserialize;
+use serde_json::{Value, json};
+use crate::sha256::{hex, sha256};
+
+const REQUEST_DOMAIN: &[u8] = b"LiliuxFlow/MTP2/native-request/v1\0";
+const RESPONSE_DOMAIN: &[u8] = b"LiliuxFlow/MTP2/native-response/v1\0";
+const MAX_INT: u64 = (1u64 << 53) - 1;
+const MAX_TTL: u64 = 30;
+const MAX_LIVE: usize = 8; // fixed queue4 + active2 + preparation2
+const MAX_RECENT: usize = 128;
+const RECENT_TTL: u64 = 120;
+const MAX_NONCES: usize = 4096;
+const MAX_RESPONSE: usize = 32768;
+const PREFIX: &str = "x-liliuxflow-control-";
+const REQUEST_FIELDS: [&str; 12] = ["version", "operation", "epoch", "nonce", "tenant",
+    "alias", "profile", "challenge", "issued", "expires", "body-sha256", "mac"];
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Error { Key, Header, Frame, Mac, Expiry, Epoch, Body, Schema, Capacity,
+    Replay, Origin, Transition, Unknown, Poisoned, Counter, Platform, Store }
+impl std::fmt::Display for Error {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "mtp2_control_{:?}", self)
+    }
+}
+impl std::error::Error for Error {}
+type Result<T> = std::result::Result<T, Error>;
+
+#[cfg(target_os = "macos")]
+#[link(name = "System")]
+unsafe extern "C" {
+    fn CCHmac(algorithm: u32, key: *const c_void, key_len: usize,
+        data: *const c_void, data_len: usize, out: *mut c_void);
+    fn timingsafe_bcmp(a: *const c_void, b: *const c_void, len: usize) -> i32;
+}
+fn mac(key: &[u8], data: &[u8]) -> Result<[u8; 32]> {
+    #[cfg(target_os = "macos")]
+    { let mut out = [0; 32];
+      // SDK: uint32_t algorithm2/SHA256, size_t lengths, caller-owned32B output.
+      unsafe { CCHmac(2, key.as_ptr().cast(), key.len(), data.as_ptr().cast(), data.len(), out.as_mut_ptr().cast()); }
+      Ok(out) }
+    #[cfg(not(target_os = "macos"))]
+    { let _ = (key, data); Err(Error::Platform) }
+}
+fn equal_mac(a: &[u8; 32], b: &[u8; 32]) -> Result<bool> {
+    #[cfg(target_os = "macos")]
+    { Ok(unsafe { timingsafe_bcmp(a.as_ptr().cast(), b.as_ptr().cast(), 32) == 0 }) }
+    #[cfg(not(target_os = "macos"))]
+    { let _ = (a, b); Err(Error::Platform) }
+}
+fn decode<const N: usize>(text: &str) -> Result<[u8; N]> {
+    if text.len() != 2 * N { return Err(Error::Frame); }
+    let digit = |b| match b { b'0'..=b'9' => Ok(b - b'0'), b'a'..=b'f' => Ok(b - b'a' + 10), _ => Err(Error::Frame) };
+    let mut out = [0; N];
+    for (i, pair) in text.as_bytes().chunks_exact(2).enumerate() { out[i] = digit(pair[0])? * 16 + digit(pair[1])?; }
+    Ok(out)
+}
+pub(super) struct Key([u8; 32]); // No Debug/Clone/Serialize; never retain an env string.
+impl Key {
+    pub(super) fn from_hex(text: &str) -> Result<Self> { decode(text).map(Self).map_err(|_| Error::Key) }
+}
+impl Drop for Key {
+    fn drop(&mut self) {
+        for byte in &mut self.0 { unsafe { std::ptr::write_volatile(byte, 0); } }
+        compiler_fence(Ordering::SeqCst);
+    }
+}
+fn lp(domain: &[u8], values: &[&str]) -> Result<Vec<u8>> {
+    let mut out = domain.to_vec();
+    for value in values {
+        if value.len() > u16::MAX as usize || !value.bytes().all(|b| (0x21..=0x7e).contains(&b)) { return Err(Error::Frame); }
+        out.extend_from_slice(&(value.len() as u16).to_be_bytes()); out.extend_from_slice(value.as_bytes());
+    }
+    Ok(out)
+}
+fn decimal(text: &str) -> Result<u64> {
+    if text.is_empty() || text.len() > 16 || (text.len() > 1 && text.starts_with('0')) || !text.bytes().all(|b| b.is_ascii_digit()) { return Err(Error::Frame); }
+    let value = text.parse::<u64>().map_err(|_| Error::Frame)?;
+    if value > MAX_INT { return Err(Error::Frame); } Ok(value)
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(super) struct TenantScope([u8; 32]); // No diagnostic/JSON representation.
+impl TenantScope { pub(super) fn parse(text: &str) -> Result<Self> { decode(text).map(Self) } }
+#[derive(Clone, Copy, PartialEq, Eq, Hash)]
+struct Epoch([u8; 32]);
+impl Epoch { fn parse(text: &str) -> Result<Self> { decode(text).map(Self) } fn text(self) -> String { hex(&self.0) } }
+#[derive(Clone, Copy, PartialEq, Eq, Hash)]
+struct Nonce([u8; 16]);
+impl Nonce { fn parse(text: &str) -> Result<Self> { decode(text).map(Self) } fn text(self) -> String { hex(&self.0) } }
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Profile { C64, C128, C262 }
+impl Profile {
+    fn parse(id: &str, alias: &str) -> Result<Self> {
+        for p in [Self::C64, Self::C128, Self::C262] { if p.id() == id && p.alias() == alias { return Ok(p); } }
+        Err(Error::Frame)
+    }
+    fn id(self) -> &'static str { match self { Self::C64 => "ctx64k-mtp2", Self::C128 => "ctx128k-mtp2", Self::C262 => "ctx262k-mtp2" } }
+    fn alias(self) -> &'static str { match self { Self::C64 => "qwen3.8-flash-next-lily-q4-mtp2-64k", Self::C128 => "qwen3.8-flash-next-lily-q4-mtp2-128k", Self::C262 => "qwen3.8-flash-next-lily-q4-mtp2-262k" } }
+}
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(super) enum Operation { Infer, State, Status, Cancel }
+impl Operation {
+    fn parse(op: &str, target: &str) -> Result<Self> {
+        match (op, target) {
+            ("infer", "/v1/chat/completions" | "/v1/completions") => Ok(Self::Infer),
+            ("state", "/_liliuxflow/mtp2/state") => Ok(Self::State),
+            ("status", "/_liliuxflow/mtp2/status") => Ok(Self::Status),
+            ("cancel", "/_liliuxflow/mtp2/cancel") => Ok(Self::Cancel), _ => Err(Error::Frame),
+        }
+    }
+    fn text(self) -> &'static str { match self { Self::Infer => "infer", Self::State => "state", Self::Status => "status", Self::Cancel => "cancel" } }
+}
+struct Identity { epoch: Epoch, nonce: Nonce, tenant: TenantScope, profile: Profile }
+pub(super) struct Envelope { origin: Arc<()>, operation: Operation, target: String,
+    epoch: Option<Epoch>, identity: Option<Identity>, challenge: String, issued: u64, expires: u64,
+    body_sha: Option<[u8; 32]>, frame_sha: [u8; 32] }
+impl Envelope {
+    pub(super) fn operation(&self) -> Operation { self.operation }
+    pub(super) fn tenant_scope(&self) -> Result<TenantScope> { self.identity.as_ref().map(|i| i.tenant).ok_or(Error::Origin) }
+    pub(super) fn profile_id(&self) -> Result<&'static str> { self.identity.as_ref().map(|i| i.profile.id()).ok_or(Error::Origin) }
+}
