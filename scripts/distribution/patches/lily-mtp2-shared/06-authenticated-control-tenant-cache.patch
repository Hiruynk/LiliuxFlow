+                    let active = l.live.values().filter(|r| Some(r.epoch) == l.epoch && r.acquired == 1).count();
+                    let pending = l.live.values().filter(|r| Some(r.epoch) == l.epoch && r.phase == Phase::Queued).count();
+                    if active > 2 || pending > 4 { return Err(Error::Transition); }
+                    (json!({"v":1,"epoch":l.epoch.map_or(String::new(), Epoch::text),"state":l.state.text(),"revision":l.revision,
+                        "active":active,"pending":pending,"cache":cache.snapshot()}), l.epoch)
+                }
+                Operation::Status => {
+                    let q: StatusBody = serde_json::from_slice(body).map_err(|_| Error::Schema)?;
+                    if q.v != 1 || Some(Epoch::parse(&q.epoch)?) != e.epoch || q.requests.is_empty() || q.requests.len() > 8 { return Err(Error::Schema); }
+                    let ids = q.requests.iter().map(|s| Nonce::parse(s)).collect::<Result<Vec<_>>>()?;
+                    if ids.iter().copied().collect::<HashSet<_>>().len() != ids.len() { return Err(Error::Schema); }
+                    let epoch = e.epoch.ok_or(Error::Epoch)?;
+                    let records: Vec<_> = ids.into_iter().map(|n| {
+                        l.live.get(&(epoch,n)).or_else(|| l.recent.iter().find(|(_,r)| r.epoch == epoch && r.nonce == n).map(|(_,r)|r))
+                            .map_or_else(|| json!({"nonce":n.text(),"phase":"unknown"}), Row::snapshot)
+                    }).collect();
+                    (json!({"v":1,"epoch":epoch.text(),"records":records}), Some(epoch))
+                }
+                Operation::Cancel => {
+                    let q: CancelBody = serde_json::from_slice(body).map_err(|_| Error::Schema)?;
+                    let i = e.identity.as_ref().ok_or(Error::Origin)?;
+                    if q.v != 1 || Epoch::parse(&q.epoch)? != i.epoch || Nonce::parse(&q.nonce)? != i.nonce { return Err(Error::Schema); }
+                    let key = (i.epoch,i.nonce);
+                    let found = l.live.get(&key).or_else(|| l.recent.iter().find(|(_,r)| (r.epoch,r.nonce)==key).map(|(_,r)|r));
+                    let (result, revision) = match found {
+                        Some(r) if r.tenant == i.tenant && r.profile == i.profile => {
+                            if r.phase.terminal() { ("already_terminal",r.revision) }
+                            else { r.cancel.store(true, Ordering::Release); ("cancel_requested",r.revision) }
+                        }, _ => ("unknown",0),
+                    };
+                    (json!({"v":1,"epoch":i.epoch.text(),"nonce":i.nonce.text(),"result":result,"revision":revision}), Some(i.epoch))
+                }
+                Operation::Infer => return Err(Error::Frame),
+            }
+        }; // Never hold ledger lock during serialization, MAC or future socket I/O.
+        let raw = serde_json::to_vec(&document).map_err(|_| Error::Schema)?;
+        self.sign_reply(e, epoch, 200, raw)
+    }
+    fn sign_reply(&self, e: &Envelope, epoch: Option<Epoch>, status: u16, body: Vec<u8>) -> Result<SignedReply> {
+        if body.len() > MAX_RESPONSE || !(100..=599).contains(&status) { return Err(Error::Body); }
+        let epoch = epoch.map_or(String::new(), Epoch::text);
+        if epoch.is_empty() && e.operation != Operation::State { return Err(Error::Epoch); }
+        let frame = lp(RESPONSE_DOMAIN, &[e.operation.text(),"POST",&e.target,&e.challenge,&hex(&e.frame_sha),
+            &epoch,&status.to_string(),&hex(&sha256(&body))])?;
+        Ok(SignedReply { status, headers: vec![("Content-Type","application/json".into()),("Cache-Control","no-store".into()),
+            ("x-liliuxflow-control-version","1".into()),("x-liliuxflow-control-challenge",e.challenge.clone()),
+            ("x-liliuxflow-control-epoch",epoch),("x-liliuxflow-control-mac",hex(&mac(&self.key.0,&frame)?))], body })
+    }
+}
