+#[test]
+fn mtp2_control_cpu_full_inbox_drop_uses_pending_bit_and_does_not_release_peer() {
+    use crate::serve::{mtp2_control,CpuAdmissionGuard,Cmd,now};use std::sync::atomic::Ordering;
+    let fixture=CpuPolicyFixture::new();let (control,mut owner)=control_cpu_setup();let (front,rx)=control_cpu_front(&fixture,control.clone());
+    let register=|nonce:&str| {let h=mtp2_control::tests::headers(&control,"infer",CONTROL_CPU_EPOCH,nonce,b"{}",now());
+        let e=control.authenticate("POST","/v1/chat/completions",&h,now()).unwrap();control.register(&e,now()).unwrap()};
+    let (peer,peer_cancel)=register(&"1".repeat(32));control.before_publish(&peer,||front.shared.queue.admit()).unwrap();
+    front.shared.queue.left();control.queue_returned(&mut owner,&peer).unwrap();control.before_acquire(&mut owner,&peer,CONTROL_CPU_EPOCH).unwrap();
+    let nonce="2".repeat(32);let (token,cancelled)=register(&nonce);
+    for _ in 0..front.shared.queue.capacity(){assert!(front.jobs.try_send(Cmd::Wake).is_ok());}
+    let mut guard=CpuAdmissionGuard{control:control.clone(),token,queue:front.shared.queue.clone(),jobs:front.jobs.clone(),cancelled,
+        expected_profile:"ctx64k-mtp2",reserved:false,ever_reserved:false,acquired:false,scope:None,session_started:false,session_disposed:true};
+    guard.publish().unwrap();drop(guard); // try_send cannot block when inbox is full.
+    assert!(control.has_pending_cpu());assert_eq!(front.shared.queue.waiting.load(Ordering::Acquire),0);
+    assert_eq!(rx.try_iter().count(),front.shared.queue.capacity());
+    control.pump_cpu_disposals(&mut owner,now()).unwrap();assert!(!control.has_pending_cpu());
+    assert_eq!(control_cpu_record(&control,&nonce)["phase"],"rejected_without_native_state");
+    let peer_row=control_cpu_record(&control,&"1".repeat(32));assert_eq!(peer_row["phase"],"acquired");assert_eq!(peer_row["released"],0);
+    assert!(!peer_cancel.load(Ordering::Acquire));assert!(peer_row.get("proof").is_none());
+}
