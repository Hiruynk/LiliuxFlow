 /// Serves the checkpoint at `model_dir` with the engine its `model_type` names.
+/// Called before any listener/thread/model operation. Descriptor contents are
+/// exact64 lowercase hex and immediately dropped; no environment key is read.
+fn read_control_key(fd:i32) -> Result<(mtp2_control::Control,mtp2_control::EngineAuthority)> {
+    use std::os::fd::FromRawFd;
+    use std::os::unix::fs::MetadataExt;
+    use std::io::Read;
+    ensure!(fd>=3,"mtp2_control_key_descriptor");
+    // The product runner owns and passes this read-only descriptor once.
+    let file=unsafe{std::fs::File::from_raw_fd(fd)};
+    let before=file.metadata().map_err(|_|anyhow::anyhow!("mtp2_control_key_metadata"))?;
+    let flags=unsafe{libc::fcntl(fd,libc::F_GETFL)};
+    ensure!(flags>=0 && flags&libc::O_ACCMODE==libc::O_RDONLY && before.file_type().is_file()
+        && before.uid()==unsafe{libc::getuid()} && before.mode()&0o7777==0o600 && before.len()==64,
+        "mtp2_control_key_ownership");
+    let mut bytes=Vec::with_capacity(65);
+    // All failures after reading pass through the bounded buffer wipe.
+    let parsed=(|| -> Result<mtp2_control::Key> {
+        let mut limited=(&file).take(65);
+        limited.read_to_end(&mut bytes).map_err(|_|anyhow::anyhow!("mtp2_control_key_read"))?;
+        let after=file.metadata().map_err(|_|anyhow::anyhow!("mtp2_control_key_metadata"))?;
+        ensure!(bytes.len()==64 && before.dev()==after.dev() && before.ino()==after.ino()
+            && before.len()==after.len() && before.mtime()==after.mtime() && before.mtime_nsec()==after.mtime_nsec()
+            && before.ctime()==after.ctime() && before.ctime_nsec()==after.ctime_nsec()
+            && before.uid()==after.uid() && before.mode()==after.mode(),"mtp2_control_key_changed");
+        Ok(mtp2_control::Key::from_hex(std::str::from_utf8(&bytes).map_err(|_|anyhow::anyhow!("mtp2_control_key_format"))?)?)
+    })();
+    for b in &mut bytes {unsafe{std::ptr::write_volatile(b,0);}}
+    std::sync::atomic::compiler_fence(Ordering::SeqCst);
+    drop(file);Ok(mtp2_control::Control::new(parsed?))
+}
