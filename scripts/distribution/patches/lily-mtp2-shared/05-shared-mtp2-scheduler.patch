+    pub request_id: &'a str,
+    pub epoch: &'a str,
+    pub step_id: &'a mut u64,
+    pub step_index: &'a mut usize,
+    pub base_drafted: usize,
+    pub base_accepted: usize,
+    pub steps: usize,
+    pub max_steps: usize,
+    pub waiting: &'a dyn Fn() -> bool,
+    pub delivered: &'a std::cell::Cell<usize>,
+    pub delivered_checkpoint: usize,
+}
+
+impl crate::generate::SpecStepControl for QuantumControl<'_> {
+    fn wants_yield(&self) -> bool { self.steps + 1 >= self.max_steps || (self.waiting)() }
+
+    fn settled(&mut self, step: crate::generate::SpecStep) -> Result<()> {
+        let settled_ns = monotonic_ns();
+        ensure!(step.produced_ns > 0 && step.produced_ns <= settled_ns,
+            "MTP2 completed step clock is invalid");
+        ensure!(step.draft_count == DRAFTS && step.proposed == DRAFTS,
+            "normal MTP2 quantum did not propose two drafts");
+        ensure!(step.generated_count > 0 && step.generated_start > 0
+            && step.generated_start - 1 + step.generated_count == step.generated_total
+            && step.accepted <= step.proposed,
+            "MTP2 step generation range is invalid");
+        *self.step_id = self.step_id.checked_add(1).context("MTP2 step counter overflow")?;
+        *self.step_index = self.step_index.checked_add(1).context("MTP2 row step counter overflow")?;
+        self.steps += 1;
+        let delivered = self.delivered.get() - self.delivered_checkpoint;
+        self.delivered_checkpoint = self.delivered.get();
+        let mode = if step.thinking_control { "thinking_control" } else { "normal" };
+        eprintln!("[lily-meta] request_id={} phase=mtp2_step protocol=1 clock={CLOCK} produced_ns={} settled_ns={settled_ns} resident_epoch={} step_id={} step_index={} step_mode={mode} draft_count={} draft_tokens_proposed={} draft_tokens_accepted={} generated_token_start={} generated_token_count={} generated_tokens={} delivered_token_count={delivered} cumulative_delivered={} cumulative_drafted={} cumulative_accepted={} position={}",
+            self.request_id, step.produced_ns,
+            self.epoch, self.step_id, self.step_index, step.draft_count,
+            step.proposed, step.accepted, step.generated_start, step.generated_count,
+            step.generated_total, self.delivered.get(), self.base_drafted + step.cumulative_drafted,
+            self.base_accepted + step.cumulative_accepted, step.position);
