+    fn same(a: &Observation, b: &Observation, stage: &str) {
+        if let Some(first) = first_mismatch(a, b) {
+            eprintln!("V16_FAILURE {}", failure_metadata(a, b, stage));
+            panic!("V16 {stage}: {first}");
+        }
+    }
