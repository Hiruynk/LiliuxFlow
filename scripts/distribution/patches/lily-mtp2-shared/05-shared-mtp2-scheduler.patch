+    fn prefix_geometry(state: &DecodeState) -> Vec<serde_json::Value> {
+        let mut regions = Vec::new();
+        let mut cursor = 0usize;
+        for (layer, lstate) in state.layers.iter().enumerate()
+            .map(|(i, l)| (format!("trunk_layer_{i}"), l))
+            .chain(state.mtp.iter().map(|m| ("draft_head".to_owned(), &m.layer))) {
+            let LayerState::Attn { k_cache, v_cache, idx_keys, blk_keys } = lstate else { continue };
+            let capacity = k_cache.values.shape()[1];
+            let blocks = blk_keys.shape()[0];
+            assert!(blocks > 0 && capacity.is_multiple_of(blocks));
+            let ratio = capacity / blocks;
+            for (store, tensor) in [("K", &k_cache.values), ("V", &v_cache.values),
+                ("indexer_keys", idx_keys), ("block_keys", blk_keys)] {
+                let shape = tensor.shape();
+                let element_bytes = tensor.dtype().size();
+                assert_eq!(element_bytes, 2, "V16 BF16 prefix geometry");
+                let width = *shape.last().expect("V16 tensor width");
+                let heads = if shape.len() == 3 { shape[0] } else { 1 };
+                let rows = if store == "block_keys" { state.pos.div_ceil(ratio) } else { state.pos };
+                for head in 0..heads {
+                    let bytes = rows * width * element_bytes;
+                    regions.push(serde_json::json!({"label":format!("{layer}.{store}.head{head}"),
+                        "layer":layer,"store":store,"head":head,"tensor_shape":shape,
+                        "state_position":state.pos,"capacity":capacity,"compress_ratio":ratio,
+                        "rows":rows,"row_bytes":width*element_bytes,"element_bytes":element_bytes,
+                        "serialized_start":cursor,"serialized_end":cursor+bytes}));
+                    cursor += bytes;
+                }
+            }
+        }
+        regions
+    }
+
+    fn prefix_location(observation: &Observation, offset: usize) -> Option<serde_json::Value> {
+        let geometry: Vec<serde_json::Value> = serde_json::from_slice(observation.get("prefix_geometry")?).ok()?;
+        let mut region = geometry.into_iter().find(|r| {
+            let start = r["serialized_start"].as_u64().unwrap_or(u64::MAX) as usize;
+            let end = r["serialized_end"].as_u64().unwrap_or(0) as usize;
+            start <= offset && offset < end
+        })?;
+        let local = offset - region["serialized_start"].as_u64()? as usize;
+        let row_bytes = region["row_bytes"].as_u64()? as usize;
+        let element = region["element_bytes"].as_u64()? as usize;
+        if row_bytes == 0 || element == 0 { return None; }
+        region["row"] = (local / row_bytes).into();
+        region["column"] = ((local % row_bytes) / element).into();
+        region["element_byte"] = (local % element).into();
+        region["within_fed_prefix"] = (region["store"] != "block_keys"
+            && local / row_bytes < region["state_position"].as_u64()? as usize).into();
+        Some(region)
+    }
