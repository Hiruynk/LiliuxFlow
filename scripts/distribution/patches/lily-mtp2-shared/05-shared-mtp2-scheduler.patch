+/// A cooperative stop is internal; it never becomes a response terminal.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SpecYield { Quantum, PhysicalTail }
+
+pub enum ControlledSpec {
+    Finished(Speculated),
+    Yield { kind: SpecYield, drafted: usize, accepted: usize },
+}
+
+/// Numeric evidence from a complete verify/accept/rollback step, no token data.
+#[derive(Debug, Clone, Copy)]
+pub struct SpecStep {
+    pub produced_ns: u64,
+    pub generated_start: usize,
+    pub generated_count: usize,
+    pub generated_total: usize,
+    pub draft_count: usize,
+    pub proposed: usize,
+    pub accepted: usize,
+    pub cumulative_drafted: usize,
+    pub cumulative_accepted: usize,
+    pub position: usize,
+    pub thinking_control: bool,
+}
+
+pub trait SpecStepControl {
+    /// Called before choosing the next pass; no peer runs yet.
+    fn wants_yield(&self) -> bool;
+    /// Called only after the committed draft and selected rollback settled.
+    fn settled(&mut self, step: SpecStep) -> Result<()>;
+}
+
+fn spec_observe(
+    control: &mut Option<&mut dyn SpecStepControl>,
+    step: SpecStep,
+) -> Result<()> {
+    if let Some(control) = control.as_mut() { control.settled(step)?; }
+    Ok(())
+}
+
+fn spec_yield_kind(control: &Option<&mut dyn SpecStepControl>, position: usize) -> Option<SpecYield> {
+    control.as_ref().and_then(|control| {
+        if crate::kernels::attention::MAX_SEQ.saturating_sub(position)
+            < crate::serve::mtp2::PHYSICAL_TAIL_RESERVE {
+            Some(SpecYield::PhysicalTail)
+        } else if control.wants_yield() { Some(SpecYield::Quantum) } else { None }
+    })
 }
 
