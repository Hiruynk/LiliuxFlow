+    impl SpecStepControl for OneStep {
+        fn wants_yield(&self) -> bool { true }
+        fn settled(&mut self, step: SpecStep) -> anyhow::Result<()> {
+            anyhow::ensure!(step.draft_count == 2 && step.proposed == 2,
+                "V16 requires two actual drafts");
+            anyhow::ensure!(!step.thinking_control && step.accepted <= 2
+                && (1..=3).contains(&step.generated_count)
+                && step.generated_start > 1
+                && step.generated_start - 1 + step.generated_count == step.generated_total,
+                "V16 completed-step range is invalid");
+            anyhow::ensure!(self.steps == 0, "V16 quantum crossed multiple steps");
+            self.steps += 1;
