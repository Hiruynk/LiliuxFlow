 impl Qwen4ExpModel {
+    /// Retain the upstream-computed proposals without re-running the head.
+    /// The old None/Some finish paths are kept intact; only this opt-in hook
+    /// discards its explicitly unsubmitted ahead program before the row yields.
+    #[allow(clippy::too_many_arguments)]
+    pub(super) fn finish_speculation_yield<'a>(&self, ctx: &'a MetalContext,
+        state: &mut DecodeState, s: &mut Scratch, accepted: usize,
+        next: crate::engine::NextStep<'_>, draft: PendingPass<'a>,
+        continuation: &mut crate::engine::SpecContinuation,
+        header: crate::engine::SpecContinuationHeader) -> Result<()> {
+        let (proposals, ahead) = self.finish_speculation(ctx, state, s, accepted, Some(next), draft)?;
+        if let Some(ahead) = ahead {
+            if !ahead.is_deferred() {
+                s.sync.release()?;
+                ahead.wait()?;
+                anyhow::bail!("MTP2 yield encountered submitted ahead work");
+            }
+            drop(ahead);
+        }
+        s.sync.release()?;
