+/// Endpoint reservation grows only in accounting. The model still allocates
+/// caches for the actual prompt and grows them lazily in its 8192-token grid.
+pub(super) fn endpoint_tokens(prompt: usize, output: usize) -> Result<usize> {
+    ensure!(prompt > 0 && output > 0 && output <= OUTPUT_TOKENS,
+        "invalid MTP2 reservation token budget");
+    let endpoint = prompt.checked_add(output).context("MTP2 reservation overflow")?;
+    ensure!(endpoint <= RESIDENT_CONTEXT_TOKENS, "MTP2 reservation exceeds resident context");
