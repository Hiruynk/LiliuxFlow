+        let mut mismatches = Vec::new();
+        for (component, left) in a {
+            let Some(right) = b.get(component) else {
+                mismatches.push(serde_json::json!({"component":component,"missing_rhs":true})); continue;
+            };
+            if left == right { continue; }
+            let offset = left.iter().zip(right).position(|(x, y)| x != y)
+                .unwrap_or(left.len().min(right.len()));
+            let mut row = serde_json::json!({"component":component,"first_offset":offset,
+                "lhs_bytes":left.len(),"rhs_bytes":right.len(),
+                "lhs_sha256":digest(left),"rhs_sha256":digest(right)});
+            if component == "active_kv_and_draft_kv" {
+                row["lhs_prefix_location"] = prefix_location(a, offset).unwrap_or(serde_json::Value::Null);
+                row["rhs_prefix_location"] = prefix_location(b, offset).unwrap_or(serde_json::Value::Null);
+            }
+            mismatches.push(row);
+        }
+        let draws = "drawn_tokens_internal_only";
+        serde_json::json!({"stage":stage,
+            "draw_vector_equal":a.get(draws).zip(b.get(draws)).map(|(x, y)| x == y),
+            "lhs_draw_sha256":a.get(draws).map(|v| digest(v)),
+            "rhs_draw_sha256":b.get(draws).map(|v| digest(v)),"mismatches":mismatches})
+    }
