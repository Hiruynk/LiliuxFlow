+    /// Candidate-only MTP2 resume. Yield is returned only after a full settled
+    /// step; the original max_tokens and seed draw index are never rewritten.
+    #[allow(clippy::too_many_arguments)]
+    pub fn resume_mtp2_controlled<M: LanguageModel>(
+        &self, ctx: &MetalContext, model: &M, state: &mut M::State,
+        scratch: &mut M::Scratch, tokens: &mut Vec<u32>,
+        options: &GenerateOptions<'_>, checkpoints: Option<&mut dyn DecodeCheckpointer<M::State>>,
+        on_token: &mut dyn FnMut(u32) -> Result<bool>, control: &mut dyn SpecStepControl,
+        continuation: &mut SpecContinuation, scope: &SpecContinuationScope,
+    ) -> Result<ControlledSpec> {
+        ensure!(!tokens.is_empty(), "cooperative resume needs its first draw");
+        ensure!(options.drafts == crate::serve::mtp2::DRAFTS && model.max_drafts() >= options.drafts,
+            "cooperative resume requires two available drafts");
+        continuation.check_scope(scope)?;
+        model.require_spec_continuation()?;
+        if tokens.len() >= options.max_tokens {
+            continuation.invalidate();
+            return Ok(ControlledSpec::Finished(Speculated { finish: FinishReason::Length, drafted: 0, accepted: 0 }));
+        }
+        let hook = self.thinking_hook(options);
+        let result = speculate_controlled(ctx, model, state, scratch, options.sampling,
+            options.drafts, options.max_tokens, tokens, &|t| self.is_stop(t, options),
+            checkpoints, hook.as_ref(), on_token, Some(control), Some((continuation, scope)));
+        if result.is_err() { continuation.invalidate(); }
+        result
+    }
