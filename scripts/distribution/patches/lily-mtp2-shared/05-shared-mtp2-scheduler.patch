+pub const SPEC_CONTINUATION_LOGICAL_BYTES: usize = 2 * (SAMPLE_K_CAP * 8 + 4);
+/// Each small MTL resource is conservatively charged one64KiB page.
+/// Actual MTL allocatedSize must fit before use.
+pub const SPEC_CONTINUATION_RESERVED_BYTES: usize = 3 * 65_536;
+
+#[derive(Clone, PartialEq, Eq)]
+pub struct SpecContinuationScope {
+    request_id: String,
+    epoch: String,
+    slot: usize,
+}
+impl SpecContinuationScope {
+    pub fn new(request_id: &str, epoch: &str, slot: usize) -> Result<Self> {
+        anyhow::ensure!(!request_id.is_empty() && request_id.len() <= 128
+            && !epoch.is_empty() && epoch.len() <= 128 && slot < 2,
+            "invalid MTP2 continuation identity");
+        Ok(Self { request_id: request_id.into(), epoch: epoch.into(), slot })
+    }
+}
+
+#[derive(Clone)]
+pub struct SpecContinuationHeader {
+    scope: SpecContinuationScope,
+    position: usize,
+    draw_index: usize,
+    last_unfed: u32,
+    sampling: SamplingParams,
+}
+impl SpecContinuationHeader {
+    pub fn new(scope: &SpecContinuationScope, position: usize, draw_index: usize,
+        last_unfed: u32, sampling: &SamplingParams) -> Self {
+        Self { scope: scope.clone(), position, draw_index, last_unfed, sampling: *sampling }
+    }
+    pub fn validate(&self, expected: &Self) -> Result<()> {
+        anyhow::ensure!(self.scope == expected.scope && self.position == expected.position
+            && self.draw_index == expected.draw_index && self.last_unfed == expected.last_unfed
+            && self.sampling == expected.sampling, "stale MTP2 continuation");
+        Ok(())
+    }
+}
+
+/// Tiny row-owned proposals/distributions, never views into shared scratch.
+/// Storage is reused; only the Ready header is consumed or invalidated.
+pub struct SpecContinuation {
+    scope: SpecContinuationScope,
+    ready: Option<(SpecContinuationHeader, [u32; 2])>,
+    distributions: DraftDists,
+}
+impl SpecContinuation {
+    pub fn new(ctx: &MetalContext, scope: SpecContinuationScope) -> Result<Self> {
+        let distributions = DraftDists::new(ctx, SPEC_CONTINUATION_SLOTS)?;
+        anyhow::ensure!(distributions.allocated_bytes() <= SPEC_CONTINUATION_RESERVED_BYTES,
+            "MTP2 continuation allocation exceeds reserved pages");
+        Ok(Self { scope, ready: None, distributions })
+    }
+    pub fn invalidate(&mut self) { self.ready = None; }
+    pub fn is_ready(&self) -> bool { self.ready.is_some() }
+    pub fn allocated_bytes(&self) -> usize { self.distributions.allocated_bytes() }
+    pub fn check_scope(&self, scope: &SpecContinuationScope) -> Result<()> {
+        anyhow::ensure!(&self.scope == scope, "MTP2 continuation ownership mismatch"); Ok(())
+    }
+    pub(crate) fn capture(&mut self, ctx: &MetalContext, source: &DraftDists,
+        header: SpecContinuationHeader, proposals: Vec<u32>) -> Result<()> {
+        self.check_scope(&header.scope)?;
+        anyhow::ensure!(proposals.len() == SPEC_CONTINUATION_SLOTS,
+            "MTP2 continuation requires exactly two proposals");
+        source.validate_two_slots(!header.sampling.is_greedy())?;
+        self.distributions.copy_two_slots_from(ctx, source)?;
+        self.ready = Some((header, [proposals[0], proposals[1]]));
+        Ok(())
+    }
+    pub(crate) fn restore(&mut self, ctx: &MetalContext, target: &DraftDists,
+        expected: &SpecContinuationHeader) -> Result<Option<Vec<u32>>> {
+        self.check_scope(&expected.scope)?;
+        let Some((header, proposals)) = &self.ready else { return Ok(None) };
+        header.validate(expected)?;
+        self.distributions.validate_two_slots(!header.sampling.is_greedy())?;
+        target.copy_two_slots_from(ctx, &self.distributions)?;
+        let proposals = proposals.to_vec(); self.ready = None;
+        Ok(Some(proposals))
+    }
+}
 
