+fn validate_usage(value:&Value,facts:PreparedUsage)->Result<()> {
+    let map=value.as_object().ok_or(Error::Schema)?;
+    let required=["prompt_tokens","completion_tokens","total_tokens","prompt_tokens_details"];
+    if map.len()!=4+usize::from(map.contains_key("completion_tokens_details")) || required.iter().any(|k|!map.contains_key(*k)) {return Err(Error::Schema);}
+    let get=|v:&Value|v.as_u64().filter(|n|*n<=MAX_INT).ok_or(Error::Counter);
+    let prompt=get(&value["prompt_tokens"])?;let completion=get(&value["completion_tokens"])?;
+    if prompt!=facts.prompt as u64 || completion>65536 || get(&value["total_tokens"])?!=prompt.checked_add(completion).ok_or(Error::Counter)? {return Err(Error::Schema);}
+    let cache=value["prompt_tokens_details"].as_object().ok_or(Error::Schema)?;
+    if cache.len()!=1 || get(&value["prompt_tokens_details"]["cached_tokens"])?!=facts.cached as u64 {return Err(Error::Schema);}
+    let details=value.get("completion_tokens_details").and_then(Value::as_object);
+    if map.contains_key("completion_tokens_details") && details.is_none(){return Err(Error::Schema);}
+    if facts.chat && details.is_none_or(|m|!m.contains_key("reasoning_tokens")) {return Err(Error::Schema);}
+    if let Some(d)=details {
+        if d.keys().any(|k|!matches!(k.as_str(),"reasoning_tokens"|"accepted_prediction_tokens"|"rejected_prediction_tokens")) {return Err(Error::Schema);}
+        if let Some(n)=d.get("reasoning_tokens") {if !facts.chat || get(n)?>completion {return Err(Error::Schema);}}
+        match (d.get("accepted_prediction_tokens"),d.get("rejected_prediction_tokens")) {
+            (Some(a),Some(r))=>{if get(a)?.checked_add(get(r)?).filter(|n|*n<=MAX_INT).is_none(){return Err(Error::Counter);}},
+            (None,None)=>{},_=>return Err(Error::Schema),
+        }
+    }Ok(())
