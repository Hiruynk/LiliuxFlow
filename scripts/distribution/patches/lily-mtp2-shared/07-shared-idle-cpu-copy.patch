diff --git a/src/metal/idle_shared.rs b/src/metal/idle_shared.rs
new file mode 100644
--- /dev/null
+++ b/src/metal/idle_shared.rs
@@ -0,0 +1,140 @@
+//! Private, fail-closed host access to settled continuation distributions.
+//! No wait, submit, event signal, GPU allocation, or public unsafe API.
+use std::rc::Rc;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Mutex, MutexGuard};
+
+use anyhow::{Result, anyhow, ensure};
+use objc2_metal::MTLBuffer;
+
+use super::{Fault, MetalContext};
+use crate::tensor::Tensor;
+
+/// Holds the existing submission mutex until all three host copies finish.
+/// Its private constructor checks the latest context-wide fence, so neither
+/// a pending row nor a concurrently submitted pass can touch these buffers.
+pub(crate) struct IdleSharedAccess<'a> {
+    ctx: &'a MetalContext,
+    _submission: MutexGuard<'a, ()>,
+}
+
+fn lock_completed_submit<'a>(submit: &'a Mutex<()>, latest: &AtomicU64,
+    fault: &Fault, completed: impl FnOnce() -> u64) -> Result<MutexGuard<'a, ()>> {
+    let guard = submit.lock().map_err(|_| anyhow!("MTP2 host copy submission lock poisoned"))?;
+    fault.check()?;
+    let frontier = latest.load(Ordering::Acquire);
+    ensure!(completed() >= frontier, "MTP2 host copy requires completed GPU frontier");
+    fault.check()?;
+    Ok(guard)
+}
+
+pub(super) fn acquire(ctx: &MetalContext) -> Result<IdleSharedAccess<'_>> {
+    let submission = lock_completed_submit(&ctx.submit, &ctx.fence_value,
+        &ctx.fault, || ctx.fence.signaled_value())?;
+    Ok(IdleSharedAccess { ctx, _submission: submission })
+}
+
+#[derive(Clone, Copy)]
+struct CopyRange {
+    owner: usize,
+    base: usize,
+    allocation_len: usize,
+    offset: usize,
+    len: usize,
+}
+
+/// Every view is validated before the first write. The six payload ranges
+/// must be disjoint, including source/source and destination/destination.
+fn validate_ranges(owner: usize, ranges: &[CopyRange; 6]) -> Result<()> {
+    ensure!(owner != 0, "MTP2 host copy context identity unavailable");
+    let mut bounds = [(0usize, 0usize); 6];
+    for (i, range) in ranges.iter().enumerate() {
+        ensure!(range.owner == owner, "MTP2 host copy buffer belongs to another context");
+        let end_offset = range.offset.checked_add(range.len)
+            .ok_or_else(|| anyhow!("MTP2 host copy range overflow"))?;
+        ensure!(range.len > 0 && end_offset <= range.allocation_len,
+            "MTP2 host copy exceeds allocation bounds");
+        let start = range.base.checked_add(range.offset)
+            .ok_or_else(|| anyhow!("MTP2 host copy address overflow"))?;
+        let end = start.checked_add(range.len)
+            .ok_or_else(|| anyhow!("MTP2 host copy address overflow"))?;
+        bounds[i] = (start, end);
+    }
+    let cap = crate::kernels::sample::SAMPLE_K_CAP;
+    let expected = [2 * cap * 4, 2 * cap * 4, 2 * 4];
+    for i in 0..3 {
+        ensure!(ranges[i].len == expected[i] && ranges[i + 3].len == expected[i],
+            "MTP2 host copy requires complete two-slot distributions");
+    }
+    for i in 0..6 {
+        for j in i + 1..6 {
+            ensure!(bounds[i].1 <= bounds[j].0 || bounds[j].1 <= bounds[i].0,
+                "MTP2 host copy distribution ranges overlap");
+        }
+    }
+    Ok(())
+}
+
+impl IdleSharedAccess<'_> {
+    pub(crate) fn validate_two_slot_copy(&self, source: &[Tensor; 3], target: &[Tensor; 3]) -> Result<()> {
+        let owner = Rc::as_ptr(&self.ctx.residency) as usize;
+        let range = |tensor: &Tensor| {
+            let (buffer, offset) = tensor.binding();
+            CopyRange { owner: Rc::as_ptr(&buffer.residency) as usize,
+                base: buffer.contents().as_ptr() as usize, allocation_len: buffer.length(),
+                offset, len: tensor.byte_len() }
+        };
+        validate_ranges(owner, &[range(&source[0]), range(&source[1]), range(&source[2]),
+            range(&target[0]), range(&target[1]), range(&target[2])])
+    }
+
+    /// Preserve the fault check that the previous blit wait performed.
+    /// The submission mutex remains held through this check and is then dropped.
+    pub(crate) fn finish(self) -> Result<()> { self.ctx.fault.check() }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn ranges() -> [CopyRange; 6] {
+        std::array::from_fn(|i| CopyRange { owner: 7, base: 0x10000 + i * 0x10000,
+            allocation_len: 0x10000, offset: 16, len: if i % 3 == 2 { 8 } else { 8192 } })
+    }
+    #[test] fn completed_frontier_holds_existing_submit_lock_cpu() {
+        let submit = Mutex::new(()); let latest = AtomicU64::new(12); let fault = Fault::default();
+        let guard = lock_completed_submit(&submit, &latest, &fault, || 12).unwrap();
+        assert!(submit.try_lock().is_err()); drop(guard); assert!(submit.try_lock().is_ok());
+    }
+    #[test] fn unfinished_frontier_refuses_without_wait_cpu() {
+        let submit = Mutex::new(()); let latest = AtomicU64::new(12);
+        assert!(lock_completed_submit(&submit, &latest, &Fault::default(), || 11).is_err());
+        assert!(submit.try_lock().is_ok());
+    }
+    #[test] fn actual_fault_gate_refuses_and_unlocks_cpu() {
+        let submit = Mutex::new(()); let latest = AtomicU64::new(12); let fault = Fault::default();
+        fault.record("synthetic CPU fault".to_owned());
+        assert!(lock_completed_submit(&submit, &latest, &fault, || 12).is_err());
+        assert!(submit.try_lock().is_ok());
+    }
+    #[test] fn complete_three_payload_ranges_are_admitted_cpu() {
+        let values = ranges(); assert!(validate_ranges(7, &values).is_ok());
+        assert_eq!(values[..3].iter().map(|r| r.len).sum::<usize>(), 16_392);
+    }
+    #[test] fn cross_context_refuses_before_any_write_cpu() {
+        let mut values = ranges(); values[4].owner = 8;
+        assert!(validate_ranges(7, &values).is_err()); assert!(validate_ranges(0, &ranges()).is_err());
+    }
+    #[test] fn source_destination_or_internal_overlap_refuses_cpu() {
+        for (a, b) in [(0, 3), (0, 1), (3, 4)] {
+            let mut values = ranges(); values[b].base = values[a].base;
+            assert!(validate_ranges(7, &values).is_err());
+        }
+    }
+    #[test] fn partial_payload_bounds_and_address_overflow_refuse_cpu() {
+        let mut values = ranges(); values[0].len -= 4; assert!(validate_ranges(7, &values).is_err());
+        let mut values = ranges(); values[5].offset = values[5].allocation_len - 4;
+        assert!(validate_ranges(7, &values).is_err());
+        let mut values = ranges(); values[0].base = usize::MAX - 8;
+        assert!(validate_ranges(7, &values).is_err());
+    }
+}
