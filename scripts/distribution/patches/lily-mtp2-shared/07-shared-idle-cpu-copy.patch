diff --git a/src/serve/mtp2_phase_diag.rs b/src/serve/mtp2_phase_diag.rs
new file mode 100644
--- /dev/null
+++ b/src/serve/mtp2_phase_diag.rs
@@ -0,0 +1,160 @@
+//! Controlled-MTP2 numeric phase totals. Default off, no GPU operation.
+use std::cell::RefCell;
+use std::sync::OnceLock;
+
+pub const WINDOW: usize = 16;
+pub const PHASES: [&str; 13] = ["counts_in", "counts_out", "restore_copy_fence",
+    "capture_copy_fence", "host_prepare", "verify_encode_submit", "draft_encode_submit",
+    "prepare_variants", "verify_wait", "draft_wait", "pace_sleep", "pace_poll_fence",
+    "scheduler_gap"];
+#[derive(Clone, Copy)]
+pub enum Phase { CountsIn, CountsOut, Restore, Capture, HostPrepare, VerifyEncode,
+    DraftEncode, Variants, VerifyWait, DraftWait, Sleep, PollFence, Scheduler }
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Identity { pub request_id: String, pub epoch: String, pub slot: usize }
+impl Identity {
+    pub fn new(request_id: &str, epoch: &str, slot: usize) -> Option<Self> {
+        if !(1..=128).contains(&request_id.len()) || !request_id.bytes().all(|c| c.is_ascii_alphanumeric() || c == b'-' || c == b'_')
+            || epoch.len() != 64 || !epoch.bytes().all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c)) || slot >= 2 { return None; }
+        Some(Self { request_id: request_id.to_owned(), epoch: epoch.to_owned(), slot })
+    }
+}
+#[derive(Clone, Debug)]
+pub struct Totals {
+    pub identity: Identity, pub quanta: usize, pub completed_quanta: usize,
+    pub zero_step_quanta: usize, pub aborted_quanta: usize, pub spec_steps: usize,
+    pub first_step: usize, pub last_step: usize,
+    pub first_begin_ns: u64, pub last_end_ns: u64, pub whole_ns: u64,
+    pub ns: [u64; 13], pub samples: [u64; 13], pub invalid_clock: bool,
+}
+impl Totals {
+    fn new(identity: Identity, now: u64) -> Self { Self { identity, quanta: 0,
+        completed_quanta: 0, zero_step_quanta: 0, aborted_quanta: 0, spec_steps: 0,
+        first_step: 0, last_step: 0, first_begin_ns: now, last_end_ns: now, whole_ns: 0,
+        ns: [0; 13], samples: [0; 13], invalid_clock: false } }
+    fn add(&mut self, phase: Phase, start: u64, end: u64) {
+        let index = phase as usize;
+        match (end.checked_sub(start).and_then(|d| self.ns[index].checked_add(d)), self.samples[index].checked_add(1)) {
+            (Some(value), Some(samples)) => { self.ns[index] = value; self.samples[index] = samples; }
+            _ => self.invalid_clock = true,
+        }
+    }
+    pub fn line(&self) -> String {
+        let mut line = format!("[lily-meta] request_id={} phase=mtp2_phase_diag protocol=1 clock=mach_absolute_time_ns clock_conversion=host_secs_f64_to_u64_ns resident_epoch={} row_slot={} quanta={} completed_quanta={} zero_step_quanta={} aborted_quanta={} spec_steps={} first_step={} last_step={} first_begin_ns={} last_end_ns={} whole_ns={} invalid_clock={}",
+            self.identity.request_id, self.identity.epoch, self.identity.slot, self.quanta,
+            self.completed_quanta, self.zero_step_quanta, self.aborted_quanta, self.spec_steps,
+            self.first_step, self.last_step, self.first_begin_ns, self.last_end_ns, self.whole_ns, self.invalid_clock);
+        for (i, name) in PHASES.iter().enumerate() { line.push_str(&format!(" {name}_ns={} {name}_samples={}", self.ns[i], self.samples[i])); }
+        line
+    }
+}
+struct Active { slot: usize, step: usize, began: u64 }
+#[derive(Default)]
+pub struct Collector { rows: [Option<Totals>; 2], active: Option<Active>, last_end: Option<u64> }
+impl Collector {
+    pub fn begin(&mut self, enabled: bool, identity: Identity, step: usize, now: u64) -> Option<Totals> {
+        if !enabled || self.active.is_some() { return None; }
+        let slot = identity.slot;
+        let changed = self.rows[slot].as_ref().is_some_and(|row| row.identity != identity);
+        let old = if changed { self.rows[slot].take() } else { None };
+        if self.rows[slot].is_none() { self.rows[slot] = Some(Totals::new(identity, now)); }
+        self.active = Some(Active { slot, step, began: now });
+        // Previous ANY row scope end to this begin: dispatch/logging/idle/prefill, not peer execution.
+        if let Some(end) = self.last_end { self.add(Phase::Scheduler, end, now); }
+        old
+    }
+    pub fn add(&mut self, phase: Phase, start: u64, end: u64) {
+        if let Some(active) = &self.active { if let Some(row) = self.rows[active.slot].as_mut() { row.add(phase, start, end); } }
+    }
+    pub fn active(&self) -> bool { self.active.is_some() }
+    pub fn end(&mut self, step: usize, steps: usize, terminal: bool, aborted: bool, now: u64) -> Option<Totals> {
+        let active = self.active.take()?; self.last_end = Some(now);
+        let row = self.rows[active.slot].as_mut()?;
+        row.quanta += 1; // bounded by WINDOW; zero/error attempts are explicitly labelled
+        row.last_end_ns = now;
+        match now.checked_sub(active.began).and_then(|d| row.whole_ns.checked_add(d)) {
+            Some(value) => row.whole_ns = value, None => row.invalid_clock = true,
+        }
+        if aborted { row.aborted_quanta += 1; }
+        else if steps == 0 { row.zero_step_quanta += 1; }
+        else {
+            row.completed_quanta += 1;
+            if step.checked_sub(active.step) != Some(steps) { row.invalid_clock = true; }
+            match row.spec_steps.checked_add(steps) { Some(n) => row.spec_steps = n, None => row.invalid_clock = true }
+            if row.first_step == 0 { match active.step.checked_add(1) { Some(n) => row.first_step = n, None => row.invalid_clock = true } }
+            if step <= row.last_step { row.invalid_clock = true; } else { row.last_step = step; }
+        }
+        if row.quanta >= WINDOW || terminal { self.rows[active.slot].take() } else { None }
+    }
+}
+thread_local! { static DIAG: RefCell<Collector> = RefCell::new(Collector::default()); }
+fn enabled() -> bool { static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var("LILIUXFLOW_MTP2_PHASE_DIAG").ok().as_deref() == Some("1")) }
+fn now() -> u64 { super::mtp2::monotonic_ns() }
+fn emit(value: Option<Totals>) { if let Some(value) = value { eprintln!("{}", value.line()); } }
+pub struct Scope { step: usize, active: bool }
+impl Scope {
+    pub fn enter(request_id: &str, epoch: &str, slot: usize, step: usize) -> Option<Self> {
+        if !enabled() { return None; }
+        let identity = Identity::new(request_id, epoch, slot)?;
+        DIAG.with(|cell| { let mut c = cell.borrow_mut(); if c.active() { return None; }
+            emit(c.begin(true, identity, step, now())); Some(Self { step, active: true }) })
+    }
+    pub fn finish(mut self, step: usize, steps: usize, terminal: bool) {
+        DIAG.with(|cell| emit(cell.borrow_mut().end(step, steps, terminal, false, now()))); self.active = false;
+    }
+}
+impl Drop for Scope { fn drop(&mut self) { if self.active {
+    DIAG.with(|cell| emit(cell.borrow_mut().end(self.step, 0, true, true, now()))); } } }
+pub struct Span { phase: Phase, started: Option<u64> }
+impl Span {
+    pub fn enter(phase: Phase) -> Self {
+        let started = if enabled() && DIAG.with(|c| c.borrow().active()) { Some(now()) } else { None };
+        Self { phase, started }
+    }
+}
+impl Drop for Span { fn drop(&mut self) { if let Some(start) = self.started {
+    let end = now(); DIAG.with(|c| c.borrow_mut().add(self.phase, start, end)); } } }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn id(slot: usize) -> Identity { Identity::new(&format!("req-123-{slot}"), &"a".repeat(64), slot).unwrap() }
+    #[test] fn default_off_collects_nothing() { let mut c = Collector::default(); c.begin(false, id(0), 0, 10);
+        c.add(Phase::CountsIn, 10, 20); assert!(c.end(1, 1, true, false, 30).is_none()); assert!(!c.active()); }
+    #[test] fn aggregates_exact16_quanta_then_resets_range() { let mut c = Collector::default();
+        for step in 0..16 { c.begin(true, id(0), step, 100 + step as u64 * 30);
+            c.add(Phase::VerifyWait, 110, 120); let out = c.end(step + 1, 1, false, false, 120 + step as u64 * 30);
+            if step == 15 { let out = out.unwrap(); assert_eq!((out.quanta, out.first_step, out.last_step), (16, 1, 16)); assert_eq!(out.ns[8], 160); assert_eq!(out.whole_ns, 320); assert_eq!(out.spec_steps, 16); }
+            else { assert!(out.is_none()); } }
+        c.begin(true, id(0), 16, 1000); assert_eq!(c.end(17, 1, true, false, 1010).unwrap().first_step, 17); }
+    #[test] fn isolates_two_rows_and_epoch_reuse_flushes_old() { let mut c = Collector::default();
+        c.begin(true, id(0), 0, 10); c.add(Phase::Restore, 10, 25); c.end(1, 1, false, false, 30);
+        c.begin(true, id(1), 4, 40); c.add(Phase::Restore, 40, 60); let b = c.end(5, 1, true, false, 65).unwrap();
+        assert_eq!(b.ns[2], 20); assert_eq!(b.identity.slot, 1); assert_eq!(b.ns[12], 10);
+        let changed = Identity::new("req-new", &"b".repeat(64), 0).unwrap(); let old = c.begin(true, changed, 0, 70).unwrap();
+        assert_eq!(old.ns[2], 15); assert_eq!(old.identity.epoch, "a".repeat(64)); }
+    #[test] fn malformed_identity_and_backward_clock_are_not_hidden() {
+        assert!(Identity::new("prompt with spaces", &"a".repeat(64), 0).is_none());
+        assert!(Identity::new("req-1", &"G".repeat(64), 0).is_none()); assert!(Identity::new("req-1", &"a".repeat(64), 2).is_none());
+        let mut c = Collector::default(); c.begin(true, id(0), 0, 100); c.add(Phase::Sleep, 50, 20);
+        let row = c.end(1, 1, true, false, 110).unwrap(); assert!(row.invalid_clock); assert_eq!(row.ns[10], 0); }
+    #[test] fn zero_and_aborted_attempts_do_not_claim_completed_steps() {
+        let mut c = Collector::default(); c.begin(true, id(0), 8, 1);
+        let row = c.end(8, 0, true, false, 3).unwrap(); assert_eq!((row.first_step, row.last_step, row.spec_steps, row.completed_quanta, row.zero_step_quanta), (0, 0, 0, 0, 1));
+        c.begin(true, id(0), 8, 4); let row = c.end(8, 0, true, true, 6).unwrap(); assert_eq!((row.completed_quanta, row.aborted_quanta, row.first_step), (0, 1, 0));
+    }
+    #[test] fn solo_multiple_steps_use_actual_control_count() { let mut c = Collector::default(); c.begin(true, id(0), 8, 1);
+        let row = c.end(18, 10, true, false, 30).unwrap(); assert_eq!((row.quanta, row.spec_steps, row.first_step, row.last_step), (1, 10, 9, 18));
+        c.begin(true, id(0), 18, 40); assert!(c.end(20, 1, true, false, 50).unwrap().invalid_clock);
+    }
+    #[test] fn counter_overflow_marks_invalid_without_panicking() { let mut row = Totals::new(id(0), 0);
+        row.samples[0] = u64::MAX; row.add(Phase::CountsIn, 0, 1); assert!(row.invalid_clock); assert_eq!(row.ns[0], 0);
