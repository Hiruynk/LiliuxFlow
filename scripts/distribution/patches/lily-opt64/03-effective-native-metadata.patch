+#[test]
+fn managed_route_metadata_preserves_query_default_and_split_selection() {
+    let (unset, label) = SparseAttnRoute::from_value(None);
+    assert_eq!((unset, label), (SparseAttnRoute::Query, "unset"));
+    let (query, label) = SparseAttnRoute::from_value(Some("query"));
+    assert_eq!((query, label), (SparseAttnRoute::Query, "query"));
+    let (split, label) = SparseAttnRoute::from_value(Some("split"));
+    assert_eq!((split, label), (SparseAttnRoute::Split, "split"));
+    for rows in [0, 1, QSA_QUERY_MIN_ROWS - 1, QSA_QUERY_MIN_ROWS, 4096] {
+        assert_eq!(split.for_rows(rows), SparseAttnRoute::Split);
+        assert_eq!(query.for_rows(rows), if rows < QSA_QUERY_MIN_ROWS {
+            SparseAttnRoute::Split
+        } else {
+            SparseAttnRoute::Query
+        });
+    }
+}
+
+#[test]
+fn invalid_route_metadata_never_echoes_environment_input() {
+    for invalid in ["", "tile", "secret-canary", "split\nprivate-value"] {
+        let (route, requested) = SparseAttnRoute::from_value(Some(invalid));
+        assert_eq!((route, requested), (SparseAttnRoute::Query, "invalid"));
+        assert_eq!(route.label(), "query");
+        assert!(!route.dispatch_metadata(16).contains("secret-canary"));
+    }
+}
+
+#[test]
+fn managed_dispatch_metadata_reports_selected_return_not_requested_route() {
+    let selected = SparseAttnRoute::Query.for_rows(QSA_QUERY_MIN_ROWS - 1);
+    assert_eq!(selected, SparseAttnRoute::Split);
+    assert_eq!(selected.dispatch_metadata(15),
+        "LILY_QSA_DISPATCH_METADATA sparse_prefill_rows=15 route=split split_dispatch_count=1 query_dispatch_count=0");
+    assert_eq!(SparseAttnRoute::Query.for_rows(16).dispatch_metadata(16),
+        "LILY_QSA_DISPATCH_METADATA sparse_prefill_rows=16 route=query split_dispatch_count=0 query_dispatch_count=1");
+}
