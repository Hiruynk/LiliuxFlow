+
+/// Actual completed chunk boundaries, scoped to this request's resumed prefix.
+#[derive(Default)]
+struct PrefillEvidence {
+    reused: usize,
+    position: usize,
+    completed_chunks: usize,
+    emitted: bool,
+}
+
+impl PrefillEvidence {
+    fn new(reused: usize) -> Self {
+        Self { reused, position: reused, ..Self::default() }
+    }
+
+    fn completed(&mut self, request_id: &str, chunk_tokens: usize, position: usize) -> Option<String> {
+        if chunk_tokens == 0 || position.checked_sub(self.position) != Some(chunk_tokens) {
+            return None;
+        }
+        self.position = position;
+        self.completed_chunks += 1;
+        if std::mem::replace(&mut self.emitted, true) {
+            return None;
+        }
+        Some(format!(
+            "[lily-meta] request_id={request_id} phase=prefill_progress completed_chunks={} prefilled_tokens={}",
+            self.completed_chunks, position - self.reused
+        ))
+    }
+}
+
+/// A cancellation observed at disposal never puts its partial state in LRU.
+/// The release callback is not called at all in that branch.
+fn release_or_drop_cancelled_session<S>(
+    session: S,
+    client_cancelled: bool,
+    release: impl FnOnce(S) -> Evictions,
+) -> Evictions {
+    if client_cancelled {
+        drop(session);
+        Evictions::default()
+    } else {
+        release(session)
+    }
 }
 
