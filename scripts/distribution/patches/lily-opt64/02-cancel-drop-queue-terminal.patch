+/// Native request evidence only. Response completion does not release a lane:
+/// the engine explicitly closes it after session and pin cleanup.
+struct RequestMeta {
+    request_id: String,
+    began: Option<Instant>,
+    acquired: usize,
+    released: usize,
+}
+
+fn queue_rejection_line(request_id: &str, status: u16) -> String {
+    format!(
+        "[lily-meta] request_id={request_id} phase=queue_rejected status={status} queue_slot_released=true"
+    )
+}
+
+impl RequestMeta {
+    fn new(request_id: String) -> Self {
+        Self { request_id, began: None, acquired: 0, released: 0 }
+    }
+
+    fn acquire(&mut self, now: Instant, queued: Duration) -> Option<String> {
+        if self.acquired != 0 || self.released != 0 {
+            return None;
+        }
+        self.began = Some(now);
+        self.acquired = 1;
+        Some(format!(
+            "[lily-meta] request_id={} phase=lane_acquired queue_wait_ms={}",
+            self.request_id, queued.as_millis()
+        ))
+    }
+
+    fn release(&mut self, now: Instant, cancelled: bool) -> Option<String> {
+        let began = self.began.take()?;
+        self.released = 1;
+        Some(format!(
+            "[lily-meta] request_id={} phase=lane_released cancelled={cancelled} lane_ms={}",
+            self.request_id, now.saturating_duration_since(began).as_millis()
+        ))
+    }
 }
 
