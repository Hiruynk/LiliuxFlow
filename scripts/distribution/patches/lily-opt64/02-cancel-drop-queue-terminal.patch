+/// Same call/chunk grid and stop predicate with the progress hook absent or
+/// present. This checks real control order and every state byte, not timings.
+#[test]
+#[ignore = "requires LILY_MODEL_DIR_FLASH and master GPU window"]
+fn completed_chunk_callback_preserves_absent_callback_state_and_stop_order() {
+    let dir = std::env::var("LILY_MODEL_DIR_FLASH").expect("explicit test checkpoint");
+    let ctx = MetalContext::new().expect("metal context");
+    let mut model = <Qwen4ExpModel as LanguageModel>::load(
+        &ctx, Path::new(&dir), &LoadOptions::default(),
+    ).expect("load");
+    model.set_kv_format(crate::kernels::attention::KvFormat::Bf16);
+    let chunk = 256;
+    model.set_prefill_chunk(chunk).expect("chunk");
+    let prompt: Vec<u32> = (0..4 * chunk + 37)
+        .map(|i| 1000 + (i * 37 % 5000) as u32).collect();
+    let run = |observe: bool, stop_after: Option<usize>| {
+        let capacity = prompt.len() + 64;
+        let mut scratch = model.new_scratch_with_capacity(&ctx, capacity).expect("scratch");
+        let mut state = model.new_state(&ctx, capacity).expect("state");
+        let asked = std::cell::Cell::new(0usize);
+        let stop = || {
+            asked.set(asked.get() + 1);
+            stop_after.is_some_and(|n| asked.get() > n)
+        };
+        let completed = std::cell::RefCell::new(Vec::new());
+        let mut progress = |tokens, position| completed.borrow_mut().push((tokens, position));
+        let before = crate::stats::counters();
+        let fed = if observe {
+            model.prefill_until_with_progress(
+                &ctx, &mut state, &mut scratch, &prompt, None, &stop, &mut progress,
+            )
+        } else {
+            model.prefill_until(&ctx, &mut state, &mut scratch, &prompt, None, &stop)
+        }.expect("prefill");
+        let chunks = crate::stats::counters().since(before).prefill.chunks;
+        assert_eq!(state.pos, fed);
+        let marks = completed.into_inner();
+        if observe {
+            assert_eq!(marks.len() as u64, chunks);
+            assert_eq!(marks.iter().map(|m| m.0).sum::<usize>(), fed);
+            assert_eq!(marks.last().map_or(0, |m| m.1), fed);
+        } else {
+            assert!(marks.is_empty());
+        }
+        // The same next draw reads everything this controlled prefill left.
+        model.prefill(&ctx, &mut state, &mut scratch, &[4242], Some(crate::engine::Draw {
+            params: &crate::kernels::sample::SamplingParams::greedy(), step: 0,
+        })).expect("draw");
+        let logits = scratch.logits().raw_bytes().to_vec();
+        let mut caches = Vec::new();
+        state.write_prefix(fed + 1, &mut caches).expect("prefix");
+        let mut recurrent = Vec::new();
+        state.snapshot(&ctx).expect("snapshot").write_to(&mut recurrent).expect("write");
+        (fed, chunks, asked.get(), logits, caches, recurrent)
+    };
+    for stop_after in [None, Some(0), Some(1), Some(3)] {
+        assert_eq!(run(false, stop_after), run(true, stop_after),
+            "callback changed state or stop order at {stop_after:?}");
     }
 }
 
