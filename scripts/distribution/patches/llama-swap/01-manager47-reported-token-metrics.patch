+// MarshalJSON exposes an unknown overall total as null when any contributing
+// row is unknown; empty-set and complete reported-zero totals remain 0.
+func (stats ActivityStats) MarshalJSON() ([]byte, error) {
+	type plain ActivityStats
+	total := func(value, known int) *int {
+		if value < 0 || known < stats.ObservedRows {
+			return nil
+		}
+		return &value
+	}
+	return json.Marshal(struct {
+		plain
+		Input  *int `json:"total_input_tokens"`
+		Output *int `json:"total_output_tokens"`
+		Cache  *int `json:"total_cache_tokens"`
+	}{plain(stats), total(stats.TotalInputTokens, stats.KnownInputRows), total(stats.TotalOutputTokens, stats.KnownOutputRows), total(stats.TotalCacheTokens, stats.KnownCacheRows)})
+}
+
+// Nullable totals stay unknown when a typed collector decodes the DTO again.
+func (stats *ActivityStats) UnmarshalJSON(data []byte) error {
+	type plain ActivityStats
+	var dto struct {
+		plain
+		Input  *int `json:"total_input_tokens"`
+		Output *int `json:"total_output_tokens"`
+		Cache  *int `json:"total_cache_tokens"`
+	}
+	if err := json.Unmarshal(data, &dto); err != nil {
+		return err
+	}
+	value := func(number *int) int {
+		if number == nil || *number < 0 {
+			return -1
+		}
+		return *number
+	}
+	*stats = ActivityStats(dto.plain)
+	stats.TotalInputTokens, stats.TotalOutputTokens, stats.TotalCacheTokens = value(dto.Input), value(dto.Output), value(dto.Cache)
+	return nil
+}
