+func optionalMetricCount(root gjson.Result, paths ...string) (int64, bool) {
+	for _, path := range paths {
+		if number, ok := optionalMetricNumber(root, path); ok && math.Trunc(number) == number && number < float64(math.MaxInt64) {
+			return int64(number), true
+		}
+	}
+	return -1, false
+}
