+func optionalMetricNumber(root gjson.Result, paths ...string) (float64, bool) {
+	for _, path := range paths {
+		value := root.Get(path)
+		if value.Type == gjson.Number {
+			number := value.Float()
+			if !math.IsNaN(number) && !math.IsInf(number, 0) && number >= 0 {
+				return number, true
+			}
+		}
+	}
+	return 0, false
+}
