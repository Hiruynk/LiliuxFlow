+// MarshalJSON keeps unknown internal sentinels out of the public metrics DTO.
+// Stored rows/schema remain unchanged, and a backend-reported zero remains 0.
+func (metrics TokenMetrics) MarshalJSON() ([]byte, error) {
+	count := func(value int) *int {
+		if value < 0 {
+			return nil
+		}
+		return &value
+	}
+	rate := func(value float64) *float64 {
+		if value < 0 || math.IsNaN(value) || math.IsInf(value, 0) {
+			return nil
+		}
+		return &value
+	}
+	return json.Marshal(struct {
+		Cached   *int     `json:"cache_tokens"`
+		Drafted  *int     `json:"draft_tokens"`
+		Accepted *int     `json:"draft_acc_tokens"`
+		Input    *int     `json:"input_tokens"`
+		Output   *int     `json:"output_tokens"`
+		Prefill  *float64 `json:"prompt_per_second"`
+		Decode   *float64 `json:"tokens_per_second"`
+	}{count(metrics.CachedTokens), count(metrics.DraftTokens), count(metrics.DraftAccTokens), count(metrics.InputTokens), count(metrics.OutputTokens), rate(metrics.PromptPerSecond), rate(metrics.TokensPerSecond)})
+}
+
+// UnmarshalJSON prevents a nullable public DTO from turning unknown into zero
+// when an existing typed collector or peer decodes it again.
+func (metrics *TokenMetrics) UnmarshalJSON(data []byte) error {
+	var dto struct {
+		Cached   *int     `json:"cache_tokens"`
+		Drafted  *int     `json:"draft_tokens"`
+		Accepted *int     `json:"draft_acc_tokens"`
+		Input    *int     `json:"input_tokens"`
+		Output   *int     `json:"output_tokens"`
+		Prefill  *float64 `json:"prompt_per_second"`
+		Decode   *float64 `json:"tokens_per_second"`
+	}
+	if err := json.Unmarshal(data, &dto); err != nil {
+		return err
+	}
+	count := func(value *int) int {
+		if value == nil || *value < 0 {
+			return -1
+		}
+		return *value
+	}
+	rate := func(value *float64) float64 {
+		if value == nil || *value < 0 || math.IsNaN(*value) || math.IsInf(*value, 0) {
+			return -1
+		}
+		return *value
+	}
+	*metrics = TokenMetrics{count(dto.Cached), count(dto.Drafted), count(dto.Accepted), count(dto.Input), count(dto.Output), rate(dto.Prefill), rate(dto.Decode)}
+	return nil
 }
 
