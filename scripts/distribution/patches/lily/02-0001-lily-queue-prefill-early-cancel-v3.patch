+struct WatcherPermit(Arc<AtomicUsize>);
+
+impl WatcherPermit {
+    fn acquire(active: Arc<AtomicUsize>, limit: usize) -> Result<Self> {
+        active
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |count| {
+                (count < limit).then(|| count + 1)
+            })
+            .map_err(|_| anyhow::anyhow!("disconnect watcher admission is full"))?;
+        Ok(Self(active))
+    }
+}
+
+impl Drop for WatcherPermit {
+    fn drop(&mut self) {
+        self.0.fetch_sub(1, Ordering::AcqRel);
+    }
+}
+
+/// Bounded observer for this gateway profile. A pre-response FIN and a reset
+/// cancel the request. Clients that write-half-close while awaiting a response
+/// are unsupported by the declared transport contract.
+pub struct DisconnectWatcher {
+    stop: Arc<AtomicBool>,
+    thread: Option<std::thread::JoinHandle<()>>,
+    _permit: WatcherPermit,
+}
+
+impl DisconnectWatcher {
+    pub fn start(
+        stream: &TcpStream,
+        request_id: String,
+        cancelled: Arc<AtomicBool>,
+        active: Arc<AtomicUsize>,
+        limit: usize,
+    ) -> Result<Self> {
+        let permit = WatcherPermit::acquire(active, limit)?;
+        let mut watcher = stream.try_clone().context("cloning request socket")?;
+        watcher
+            .set_read_timeout(Some(Duration::from_millis(100)))
+            .context("setting disconnect watcher timeout")?;
+        let stop = Arc::new(AtomicBool::new(false));
+        let thread_stop = stop.clone();
+        let thread = std::thread::Builder::new()
+            .name("lily-watch".into())
+            .spawn(move || {
+                let mut scratch = [0u8; 256];
+                loop {
+                    match watcher.read(&mut scratch) {
+                        // The approved gateway profile excludes write-half-close.
+                        // Under that contract, a pre-response FIN is cancellation.
+                        Ok(0) => {
+                            if !thread_stop.load(Ordering::Acquire) {
+                                cancelled.store(true, Ordering::Release);
+                                eprintln!(
+                                    "[lily-meta] request_id={request_id} phase=client_fin_cancelled"
+                                );
+                            }
+                            break;
+                        }
+                        Ok(_) => {
+                            if thread_stop.load(Ordering::Acquire) {
+                                break;
+                            }
+                        }
+                        Err(error)
+                            if matches!(
+                                error.kind(),
+                                std::io::ErrorKind::WouldBlock
+                                    | std::io::ErrorKind::TimedOut
+                            ) =>
+                        {
+                            if thread_stop.load(Ordering::Acquire) {
+                                break;
+                            }
+                        }
+                        Err(error)
+                            if matches!(
+                                error.kind(),
+                                std::io::ErrorKind::ConnectionReset
+                                    | std::io::ErrorKind::ConnectionAborted
+                            ) =>
+                        {
+                            if !thread_stop.load(Ordering::Acquire) {
+                                cancelled.store(true, Ordering::Release);
+                                eprintln!(
+                                    "[lily-meta] request_id={request_id} phase=client_reset"
+                                );
+                            }
+                            break;
+                        }
+                        Err(_) => break,
+                    }
+                }
+            })
+            .context("spawning disconnect watcher")?;
+        Ok(Self { stop, thread: Some(thread), _permit: permit })
+    }
+
+    pub fn stop(&mut self) {
+        self.stop.store(true, Ordering::Release);
+        if let Some(thread) = self.thread.take() {
+            let _ = thread.join();
+        }
+    }
+}
+
+impl Drop for DisconnectWatcher {
+    fn drop(&mut self) {
+        self.stop();
+    }
+}
