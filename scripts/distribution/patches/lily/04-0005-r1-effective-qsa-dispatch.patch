+#[cfg(test)]
+mod selected_route_tests {
+    use super::{QSA_TILE_BQ, SparseAttnRoute};
+
+    #[test]
+    fn explicit_split_selects_split_for_batched_sparse_prefill() {
+        let (selected, requested) = SparseAttnRoute::from_value(Some("split"));
+        assert_eq!(selected, SparseAttnRoute::Split);
+        assert_eq!(requested, "split");
+        assert_eq!(selected.for_rows(QSA_TILE_BQ), SparseAttnRoute::Split);
+        assert_eq!(SparseAttnRoute::Tiled.for_rows(QSA_TILE_BQ - 1), SparseAttnRoute::Split);
+        assert_eq!(SparseAttnRoute::Tiled.for_rows(QSA_TILE_BQ), SparseAttnRoute::Tiled);
+    }
+
