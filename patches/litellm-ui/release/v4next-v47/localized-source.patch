+            const token = await exchangeMcpOAuthToken({
+                serverId: flowState.serverId,
+                code: payload.code as string,
+                clientId: flowState.clientId,
+                clientSecret: flowState.clientSecret,
+                codeVerifier: flowState.codeVerifier,
