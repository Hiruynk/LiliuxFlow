--- /dev/null
+++ b/ui/src/lib/outputBudget.mjs
@@ -0,0 +1,22 @@
+/** The output budget includes thinking and is bounded by remaining context. */
+export const MAX_OUTPUT_TOKENS = 65536;
+const KEY = "playground-max-tokens";
+const MIGRATION = "liliuxflow-playground-output-65536-v1";
+
+/**
+ * Migrate only the old numeric default once. Later custom values are preserved.
+ * @param {{ getItem: (key: string) => string | null, setItem: (key: string, value: string) => void }} storage
+ * @returns {boolean} Whether the old default was replaced.
+ */
+export function migrateLegacyOutputBudget(storage) {
+  try {
+    if (storage.getItem(MIGRATION) === "1") return false;
+    const saved = storage.getItem(KEY);
+    const migrate = saved !== null && JSON.parse(saved) === 4096;
+    if (migrate) storage.setItem(KEY, JSON.stringify(MAX_OUTPUT_TOKENS));
+    storage.setItem(MIGRATION, "1");
+    return migrate;
+  } catch {
+    return false;
+  }
+}
